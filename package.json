{
  "name": "bb-plugin-bb-box",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.44.0 <1.0.0",
    "bbPluginSdk": "^0.5.29"
  },
  "bb": {
    "name": "bb-box",
    "description": "Computers for BB threads: Linux boxes, with or without a desktop, that you and the agent share.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "monitor": "./assets/monitor.svg",
        "server": "./assets/server.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts && vitest run",
    "build": "bb plugin build",
    "smoke": "node scripts/smoke.ts",
    "conformance": "node scripts/conformance.ts",
    "test:app": "vitest run"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@radix-ui/react-slot": "^1.3.0",
    "undici": "^7.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "hono": "^4.13.12",
    "jsdom": "^30.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.8.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.3"
  }
