{
  "proxmox-lxc-enabled": true,
  "proxmox-lxc-url": { "file": "proxmox-token.env", "key": "PROXMOX_API_URL" },
  "proxmox-lxc-token-id": { "file": "proxmox-token.env", "key": "PROXMOX_TOKEN_ID" },
  "proxmox-lxc-token-secret": { "file": "proxmox-token.env", "key": "PROXMOX_TOKEN_SECRET" },
  "proxmox-lxc-tls-fingerprint": { "file": "proxmox-token.env", "key": "PROXMOX_TLS_SHA256_FINGERPRINT" },
  "proxmox-lxc-node": { "file": "proxmox-token.env", "key": "PROXMOX_NODE" },
  "proxmox-lxc-pool": "bbbox",
  "proxmox-lxc-linux-templates": "9100",
  "proxmox-lxc-vmid-first": 9900,
  "proxmox-lxc-vmid-last": 9999,
  "proxmox-lxc-bridge": "vmbr200",
  "proxmox-lxc-subnet": "10.200.0.0/24",
  "proxmox-lxc-gateway": "10.200.0.1",
  "proxmox-lxc-addresses": "10.200.0.10-10.200.0.254",
  "proxmox-lxc-ssh-private-key": { "file": "ssh/id_ed25519" },
  "proxmox-lxc-ssh-user": "box"
}
