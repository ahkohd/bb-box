<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="bbbox.probe">
  <application android:label="Probe">
    <activity android:name=".Main" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
  <instrumentation android:name=".Holds" android:targetPackage="bbbox.probe" />
  <instrumentation android:name=".Plain" android:targetPackage="bbbox.probe" />
</manifest>
