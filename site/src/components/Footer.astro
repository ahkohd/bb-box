---
import StarlightFooter from "@astrojs/starlight/components/Footer.astro";
import { repository, repositoryRef } from "../repo.ts";

const fileUrl = (path: string) => `${repository}/blob/${repositoryRef}/${path}`;
---

<StarlightFooter {...Astro.props} />
<p class="site-footer">
  <a href={fileUrl("LICENSE")}>MIT licence</a>
  <a href={fileUrl("THIRD-PARTY.md")}>Third-party software</a>
</p>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 3rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--muted-foreground);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--foreground);
  }
</style>
