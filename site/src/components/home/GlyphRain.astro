---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<canvas class:list={["glyph-rain", className]} data-motion aria-hidden="true"></canvas>

<script>
  import { cssValue, deviceScale } from "../../effects/gl.ts";
  import { animateWhileSeen } from "../../motion.ts";

  const glyphs = "01<>/\\=+*#%$&{}[]";
  const fontPx = 13;
  const linePx = 16;
  const everyOtherColumn = 2;
  const flipChance = 0.06;

  interface Drop {
    head: number;
    speed: number;
    length: number;
    trail: string[];
  }

  const anyGlyph = () => glyphs[Math.floor(Math.random() * glyphs.length)]!;

  function startRain(canvas: HTMLCanvasElement): void {
    const pen = canvas.getContext("2d");
    if (!pen) return;
    let drops: Drop[] = [];
    let cellWidth = 7.8;
    let rows = 0;
    let lastSeconds = 0;
    let trailInk = "";
    let headInk = "";

    const newDrop = (startAbove: boolean): Drop => {
      const length = 8 + Math.floor(Math.random() * 16);
      return { head: startAbove ? -Math.random() * rows : Math.random() * rows, speed: 4 + Math.random() * 12, length, trail: Array.from({ length }, anyGlyph) };
    };

    const restyle = () => {
      trailInk = cssValue(canvas, "--dither-ink");
      headInk = cssValue(canvas, "--field-hot");
    };

    const resize = () => {
      const scale = deviceScale();
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      pen.setTransform(scale, 0, 0, scale, 0, 0);
      pen.font = `${fontPx}px "JetBrains Mono Variable", ui-monospace, monospace`;
      pen.textBaseline = "top";
      cellWidth = pen.measureText("0").width;
      rows = Math.ceil(height / linePx);
      const columns = Math.ceil(width / (cellWidth * everyOtherColumn));
      drops = Array.from({ length: columns }, () => newDrop(false));
    };

    const draw = (seconds: number) => {
      if (!drops.length) resize();
      const step = Math.min(0.1, Math.max(0, seconds - lastSeconds));
      lastSeconds = seconds;
      const { width, height } = canvas.getBoundingClientRect();
      pen.clearRect(0, 0, width, height);
      drops.forEach((drop, column) => {
        drop.head += drop.speed * step;
        if (drop.head - drop.length > rows) Object.assign(drop, newDrop(true));
        if (Math.random() < flipChance * drop.length) drop.trail[Math.floor(Math.random() * drop.length)] = anyGlyph();
        const x = column * cellWidth * everyOtherColumn;
        const headRow = Math.floor(drop.head);
        drop.trail.forEach((glyph, back) => {
          const row = headRow - back;
          if (row < 0 || row >= rows) return;
          pen.globalAlpha = back === 0 ? 1 : 0.85 * (1 - back / drop.length) ** 1.4;
          pen.fillStyle = back === 0 ? headInk : trailInk;
          pen.fillText(glyph, x, row * linePx);
        });
      });
      pen.globalAlpha = 1;
    };

    restyle();
    document.fonts.ready.then(resize);
    animateWhileSeen(canvas, { draw, resize, restyle }, 20);
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas.glyph-rain")) startRain(canvas);
</script>

<style>
  .glyph-rain {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
