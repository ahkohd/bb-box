---
import PieceIcon from "./PieceIcon.astro";

const historyBars = 28;
---

<div class="piece monitor-piece" data-monitor-piece data-machine="proud-crane">
  <div class="card">
    <div class="card-bar">
      <PieceIcon name="monitor" class="card-glyph" />
      <button type="button" class="machine" data-pick-machine><span class="sr-only">Watching </span><span class="machine-name">proud-crane</span><PieceIcon name="chevron" /></button>
      <button type="button" class="piece-tool" data-open-page aria-label="Open the box's page"><PieceIcon name="external" /></button>
      <span class="card-end">
        <button type="button" class="piece-tool" data-refresh aria-label="Read again now"><PieceIcon name="refresh" /></button>
        <button type="button" class="piece-tool" data-card-menu aria-label="More for this machine"><PieceIcon name="chevron" /></button>
      </span>
    </div>
    <ul class="piece-menu machine-menu" role="menu" hidden>
      <li role="none"><button type="button" role="menuitem" data-choice="proud-crane"><PieceIcon name="monitor" />proud-crane</button></li>
      <li role="none"><button type="button" role="menuitem" data-choice="clear-comet"><PieceIcon name="server" />clear-comet</button></li>
    </ul>
    <ul class="piece-menu card-menu" role="menu" hidden>
      <li role="none"><button type="button" role="menuitem" data-choice="details"><PieceIcon name="info" />Open details</button></li>
      <li role="none"><button type="button" role="menuitem" data-choice="desktop"><PieceIcon name="monitor" />Open desktop</button></li>
      <li role="none"><button type="button" role="menuitem" data-choice="terminal"><PieceIcon name="terminal" />Open terminal</button></li>
      <li role="none"><button type="button" role="menuitem" data-choice="files"><PieceIcon name="folder" />Open files</button></li>
      <li role="none"><hr /></li>
      <li role="none" class="piece-menu-heading">Threads</li>
      <li role="none"><button type="button" role="menuitem" data-choice="thread">Get a Linux desktop box and open…</button></li>
    </ul>
    <div class="chips">
      <span class="chip state"><span class="piece-dot" data-state="busy"></span><span data-state-words>Busy</span></span>
      <span class="chip" data-system>Linux · x86_64</span>
      <span class="chip" data-uptime>host up 1h 12m</span>
    </div>
    <div class="metrics">
      <section class="metric" aria-label="CPU">
        <p class="metric-head"><PieceIcon name="cpu" />CPU</p>
        <p class="metric-value"><span data-cpu>100</span><span class="unit">%</span></p>
        <span class="history" aria-hidden="true">{Array.from({ length: historyBars }, () => <i />)}</span>
        <p class="metric-foot" data-cpu-words>busy · 4 cores</p>
      </section>
      <section class="metric" aria-label="Memory">
        <p class="metric-head"><PieceIcon name="memory" />Memory<span class="level" data-memory-level>Normal</span></p>
        <p class="metric-value"><span data-memory>52</span><span class="unit">%</span></p>
        <span class="meter" aria-hidden="true"><i data-memory-meter></i></span>
        <p class="metric-foot" data-memory-words>4.2 of 8 GiB</p>
      </section>
    </div>
  </div>
  <p class="piece-note" aria-live="polite">Live-looking numbers from a sample box. Try the menus.</p>
</div>

<script>
  import { pieceMenu } from "../../effects/piece-menu.ts";
  import { animateWhileSeen } from "../../motion.ts";

  interface SampleMachine {
    system: string;
    uptime: string;
    cores: number;
    memoryGib: number;
    cpuRest: number;
    cpuSwing: number;
    memoryRest: number;
  }

  const machines: Record<string, SampleMachine> = {
    "proud-crane": { system: "Linux · x86_64", uptime: "host up 1h 12m", cores: 4, memoryGib: 8, cpuRest: 88, cpuSwing: 14, memoryRest: 52 },
    "clear-comet": { system: "Linux · arm64", uptime: "host up 26m", cores: 2, memoryGib: 4, cpuRest: 18, cpuSwing: 12, memoryRest: 31 },
  };

  const menuSays: Record<string, (name: string) => string> = {
    details: (name) => `In BB, this opens ${name}'s facts and snapshots.`,
    desktop: (name) => `In BB, this opens ${name}'s desktop in a tab.`,
    terminal: (name) => `In BB, this opens ${name}'s terminal in a tab.`,
    files: (name) => `In BB, this opens ${name}'s files in a tab.`,
    thread: () => "In BB, this opens the thread that is using the box.",
  };

  const wave = (seconds: number, seed: number) => Math.sin(seconds * 0.9 + seed) * 0.6 + Math.sin(seconds * 2.3 + seed * 1.7) * 0.4;

  function startMonitor(piece: HTMLElement): void {
    const note = piece.querySelector<HTMLElement>(".piece-note")!;
    const bars = [...piece.querySelectorAll<HTMLElement>(".history i")];
    const field = (name: string) => piece.querySelector<HTMLElement>(`[data-${name}]`)!;
    const say = (text: string) => {
      note.textContent = text;
    };
    let shownSeconds = 0;
    let nudge = 0;
    const machine = () => machines[piece.dataset.machine!]!;

    const draw = (seconds: number) => {
      shownSeconds = seconds;
      const now = machine();
      const at = seconds + nudge;
      const cpuAt = (time: number) => Math.round(Math.min(100, Math.max(1, now.cpuRest + now.cpuSwing * wave(time, 1))));
      const cpu = cpuAt(at);
      const memory = Math.round(Math.min(99, now.memoryRest + 3 * wave(at * 0.3, 4)));
      field("cpu").textContent = String(cpu);
      field("memory").textContent = String(memory);
      field("memory-meter").style.width = `${memory}%`;
      field("memory-words").textContent = `${((memory / 100) * now.memoryGib).toFixed(1)} of ${now.memoryGib} GiB`;
      field("cpu-words").textContent = `${cpu >= 80 ? "busy" : "calm"} · ${now.cores} cores`;
      field("state-words").textContent = cpu >= 80 ? "Busy" : "Normal";
      piece.querySelector(".state .piece-dot")!.setAttribute("data-state", cpu >= 80 ? "busy" : "ready");
      field("memory-level").textContent = memory >= 85 ? "High" : "Normal";
      bars.forEach((bar, index) => {
        bar.style.height = `${cpuAt(at - (bars.length - 1 - index) * 1.1)}%`;
      });
    };

    const pickMachine = (name: string) => {
      piece.dataset.machine = name;
      piece.querySelector(".machine-name")!.textContent = name;
      field("system").textContent = machines[name]!.system;
      field("uptime").textContent = machines[name]!.uptime;
      draw(shownSeconds);
      say(`Watching ${name}. The Monitor shows every box.`);
    };

    pieceMenu<null>(piece.querySelector<HTMLElement>(".machine-menu")!, (choice) => pickMachine(choice)).attach(piece.querySelector<HTMLButtonElement>("[data-pick-machine]")!, null);
    pieceMenu<null>(piece.querySelector<HTMLElement>(".card-menu")!, (choice) => say(menuSays[choice]!(piece.dataset.machine!))).attach(piece.querySelector<HTMLButtonElement>("[data-card-menu]")!, null);
    piece.querySelector("[data-open-page]")!.addEventListener("click", () => say(menuSays.details!(piece.dataset.machine!)));
    piece.querySelector("[data-refresh]")!.addEventListener("click", () => {
      nudge += 3.7;
      draw(shownSeconds);
      say("Read again just now.");
    });

    animateWhileSeen(piece, { draw }, 1);
  }

  for (const piece of document.querySelectorAll<HTMLElement>("[data-monitor-piece]")) startMonitor(piece);
</script>

<style>
  .monitor-piece {
    position: relative;
  }

  .card {
    position: relative;
    max-width: 26rem;
    margin: 0 auto;
    border: 1px solid var(--border);
  }

  .card-bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.25rem 0.375rem 0.625rem;
  }

  .card-bar :global(.card-glyph) {
    color: var(--muted-foreground);
  }

  .machine {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.375rem;
    border: 0;
    background: transparent;
    font-size: 0.875rem !important;
  }

  .machine:hover,
  .machine[aria-expanded="true"] {
    background: var(--piece-row);
  }

  .card-end {
    display: inline-flex;
    margin-left: auto;
  }

  .machine-menu {
    top: 2.5rem;
    left: 1.5rem;
  }

  .card-menu {
    top: 2.5rem;
    right: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    background: var(--piece-row);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .chip.state {
    color: var(--foreground);
  }

  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .metric {
    padding: 0.75rem 0.75rem 0.875rem;
  }

  .metric + .metric {
    border-left: 1px solid var(--border);
  }

  .metric p {
    margin: 0;
  }

  .metric-head {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--foreground);
  }

  .metric-head :global(.piece-icon) {
    color: var(--muted-foreground);
  }

  .level {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--muted-foreground);
  }

  .metric-value {
    margin: 0.5rem 0 0.375rem !important;
    font-size: 2rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    margin-left: 0.25rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .history {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 2rem;
  }

  .history i {
    flex: 1;
    min-height: 1px;
    background: var(--accent);
    opacity: 0.75;
  }

  .meter {
    display: block;
    height: 2rem;
    background: var(--piece-row);
  }

  .meter i {
    display: block;
    height: 100%;
    background: var(--muted-foreground);
    opacity: 0.55;
  }

  .metric-foot {
    margin-top: 0.5rem !important;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
</style>
