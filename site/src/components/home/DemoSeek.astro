---
import { clockOf, demoSeconds } from "../../demo.ts";
---

<span class="demo-seek" role="slider" tabindex="0" aria-label="Seek demo" aria-valuemin="0" aria-valuemax={demoSeconds} aria-valuenow="0" aria-valuetext={`${clockOf(0)} of ${clockOf(demoSeconds)}`}>
  <canvas class="seek-dots" data-motion aria-hidden="true"></canvas>
  <span class="seek-tip" data-seek-tip aria-hidden="true" hidden></span>
</span>

<style>
  .demo-seek {
    position: relative;
    flex: 1;
    align-self: stretch;
    min-height: 1.75rem;
    cursor: pointer;
    touch-action: pan-y;
  }

  .demo-seek:focus-visible {
    outline: 1px dotted var(--accent);
    outline-offset: 2px;
  }

  .seek-dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .seek-tip {
    position: absolute;
    bottom: calc(100% + 0.25rem);
    transform: translateX(-50%);
    padding: 0 0.375rem;
    background: var(--background);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .seek-tip[hidden] {
    display: none;
  }
</style>
