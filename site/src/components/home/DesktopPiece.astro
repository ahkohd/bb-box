---
import PieceIcon from "./PieceIcon.astro";

const boxName = "proud-crane";
---

<div class="piece desktop-piece" data-desktop-piece data-owner="agent">
  <div class="control-bar">
    <PieceIcon name="monitor" class="bar-glyph" />
    <span class="bar-name">{boxName}</span>
    <span class="piece-dot" data-state="ready"></span>
    <span class="control-words" aria-live="polite">The agent has control.</span>
    <span class="bar-end">
      <button type="button" class="take" data-take>Take control</button>
      <button type="button" class="piece-tool" data-desktop-menu aria-label="More for the desktop"><PieceIcon name="more" /></button>
    </span>
  </div>
  <ul class="piece-menu desktop-menu" role="menu" hidden>
    <li role="none"><button type="button" role="menuitem" data-choice="terminal"><PieceIcon name="terminal" />Open terminal</button></li>
    <li role="none"><button type="button" role="menuitem" data-choice="paste"><PieceIcon name="folder" />Send text to the box</button></li>
    <li role="none"><button type="button" role="menuitem" data-choice="full"><PieceIcon name="resize" />Full screen</button></li>
  </ul>
  <div class="screen" data-screen role="img" aria-label={`${boxName}'s desktop: a browser on example.com, used by the agent until you take control.`}>
    <div class="taskbar" aria-hidden="true">
      <span>Applications</span>
      <span class="taskbar-window">example.com — Browser</span>
      <span class="clock">09:41</span>
    </div>
    <div class="window" aria-hidden="true">
      <div class="window-bar">
        <span class="window-dots"><i></i><i></i><i></i></span>
        <span class="address">example.com</span>
      </div>
      <div class="page">
        <span class="page-title">Example Domain</span>
        <span class="line long"></span>
        <span class="line"></span>
        <span class="line short"></span>
        <span class="page-button" data-agent-target>Continue</span>
      </div>
    </div>
    <span class="agent-pointer" aria-hidden="true"><PieceIcon name="pointer" /><span class="agent-label">agent</span></span>
    <span class="your-click" aria-hidden="true" hidden></span>
  </div>
  <p class="piece-note" aria-live="polite">The agent is using the desktop. Take control to use it yourself.</p>
</div>

<script>
  import { pieceMenu } from "../../effects/piece-menu.ts";

  const menuSays: Record<string, string> = {
    terminal: "In BB, this opens the box's terminal beside its desktop.",
    paste: "In BB, this types text from your computer into the box while you have control.",
    full: "In BB, this fills the screen with the desktop.",
  };

  function startDesktop(piece: HTMLElement): void {
    const take = piece.querySelector<HTMLButtonElement>("[data-take]")!;
    const words = piece.querySelector<HTMLElement>(".control-words")!;
    const note = piece.querySelector<HTMLElement>(".piece-note")!;
    const screen = piece.querySelector<HTMLElement>("[data-screen]")!;
    const click = piece.querySelector<HTMLElement>(".your-click")!;
    const say = (text: string) => {
      note.textContent = text;
    };

    take.addEventListener("click", () => {
      const yours = piece.dataset.owner !== "you";
      piece.dataset.owner = yours ? "you" : "agent";
      take.textContent = yours ? "Hand back to the agent" : "Take control";
      words.textContent = yours ? "You have control. Hand back when done." : "The agent has control.";
      say(yours ? "The agent waits while you have control. Select the desktop to use it." : "The agent carries on where it left off.");
    });

    screen.addEventListener("click", (event) => {
      if (piece.dataset.owner !== "you") {
        say("Take control first, then use the desktop.");
        return;
      }
      const box = screen.getBoundingClientRect();
      click.style.left = `${event.clientX - box.left}px`;
      click.style.top = `${event.clientY - box.top}px`;
      click.hidden = false;
      click.classList.remove("ping");
      void click.offsetWidth;
      click.classList.add("ping");
      say("In BB, your clicks and keys go to the box. Here they stay on this page.");
    });

    const menu = pieceMenu<null>(piece.querySelector<HTMLElement>(".desktop-menu")!, (choice) => say(menuSays[choice]!));
    menu.attach(piece.querySelector<HTMLButtonElement>("[data-desktop-menu]")!, null);

    new IntersectionObserver((entries) => piece.toggleAttribute("data-seen", entries.some((entry) => entry.isIntersecting))).observe(piece);
  }

  for (const piece of document.querySelectorAll<HTMLElement>("[data-desktop-piece]")) startDesktop(piece);
</script>

<style>
  .desktop-piece {
    position: relative;
  }

  .control-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem 0.5rem;
    padding: 0.375rem 0.25rem 0.375rem 0.5rem;
    border: 1px solid var(--border);
    border-bottom: 0;
  }

  .control-bar :global(.bar-glyph) {
    color: var(--muted-foreground);
  }

  .control-words {
    color: var(--muted-foreground);
  }

  .bar-end {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .take {
    height: 1.875rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    background: transparent;
  }

  .take:hover {
    border-color: var(--muted-foreground);
  }

  [data-owner="you"] .take {
    border-color: var(--foreground);
  }

  .desktop-menu {
    top: 2.75rem;
    right: 0;
  }

  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--sample-desktop);
  }

  [data-owner="you"] .screen {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .taskbar {
    display: flex;
    gap: 1rem;
    padding: 0.25rem 0.625rem;
    background: var(--sample-taskbar);
    font-size: 0.625rem;
    color: var(--sample-taskbar-ink);
  }

  .taskbar-window {
    padding: 0 0.5rem;
    border-bottom: 1px solid var(--sample-taskbar-mark);
  }

  .clock {
    margin-left: auto;
  }

  .window {
    position: absolute;
    left: 14%;
    top: 16%;
    width: 72%;
    height: 66%;
    display: flex;
    flex-direction: column;
    background: var(--sample-window);
    color: var(--sample-window-ink);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.3125rem 0.5rem;
    background: var(--sample-window-bar);
    font-size: 0.625rem;
  }

  .window-dots {
    display: inline-flex;
    gap: 0.25rem;
  }

  .window-dots i {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--sample-control);
  }

  .address {
    flex: 1;
    padding: 0.125rem 0.5rem;
    background: var(--sample-window);
    color: var(--sample-window-muted);
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 9% 12%;
  }

  .page-title {
    font-size: 1rem;
  }

  .line {
    height: 0.375rem;
    width: 70%;
    background: var(--sample-line);
  }

  .line.long {
    width: 90%;
  }

  .line.short {
    width: 45%;
  }

  .page-button {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.25rem 0.625rem;
    background: var(--sample-window-ink);
    color: var(--sample-window);
    font-size: 0.625rem;
  }

  .agent-pointer {
    position: absolute;
    left: 30%;
    top: 60%;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.125rem;
    color: var(--sample-window);
    filter: drop-shadow(0 0 1px var(--sample-window-ink));
    animation: agent-works 7s ease-in-out infinite;
    animation-play-state: paused;
  }

  .agent-pointer :global(.piece-icon) {
    fill: var(--sample-window-ink);
    stroke: var(--sample-window);
  }

  .agent-label {
    padding: 0 0.25rem;
    margin-top: 0.75rem;
    background: var(--accent-fill);
    color: var(--accent-ink);
    font-family: var(--sl-font-mono);
    font-size: 0.5625rem;
    filter: none;
  }

  [data-seen] .agent-pointer {
    animation-play-state: running;
  }

  [data-owner="you"] .agent-pointer {
    opacity: 0;
    transition: opacity 200ms ease;
  }

  @keyframes agent-works {
    0%,
    8% {
      left: 30%;
      top: 60%;
    }
    30%,
    38% {
      left: 64%;
      top: 34%;
    }
    55%,
    66% {
      left: 26%;
      top: 76%;
    }
    86%,
    100% {
      left: 30%;
      top: 60%;
    }
  }

  .your-click {
    position: absolute;
    width: 1.5rem;
    height: 1.5rem;
    margin: -0.75rem 0 0 -0.75rem;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    pointer-events: none;
  }

  .your-click.ping {
    animation: ping 420ms ease-out forwards;
  }

  @keyframes ping {
    from {
      transform: scale(0.4);
      opacity: 1;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  :global([data-motion="paused"]) .agent-pointer,
  :global([data-motion="paused"]) .your-click.ping {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-pointer,
    .your-click.ping {
      animation: none;
    }

    [data-owner="you"] .agent-pointer {
      transition: none;
    }
  }
</style>
