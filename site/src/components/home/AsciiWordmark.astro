---
import CipherText from "./CipherText.astro";

const wordmarkRows = 12;
---

<div class="wordmark" aria-hidden="true" style={`--rows: ${wordmarkRows}`} data-rows={wordmarkRows}>
  <CipherText text="" duration={1400} decorative />
</div>

<script>
  import { watchCiphers } from "../../effects/cipher.ts";

  const ramp = " .:-=+*#%@";
  const word = "BB Box";
  const cellAspect = 2;

  function drawWordmark(holder: HTMLElement): void {
    const real = holder.querySelector<HTMLElement>(".cipher-real");
    if (!real) return;
    const rows = Number(holder.dataset.rows);
    const probe = document.createElement("canvas").getContext("2d")!;
    probe.font = getComputedStyle(holder).font;
    const columns = Math.floor(holder.clientWidth / probe.measureText("0").width);
    const sheet = document.createElement("canvas");
    sheet.width = columns;
    sheet.height = rows * cellAspect;
    const pen = sheet.getContext("2d", { willReadFrequently: true })!;
    const fontPx = Math.min(sheet.height * 0.92, (sheet.height * 0.92 * columns) / Math.max(1, measureAt(pen, sheet.height * 0.92)));
    pen.font = `${fontPx}px "Inter Variable", system-ui, sans-serif`;
    pen.fillStyle = "#ffffff";
    pen.textBaseline = "middle";
    pen.fillText(word, 0, sheet.height / 2);
    const pixels = pen.getImageData(0, 0, sheet.width, sheet.height).data;
    const lines: string[] = [];
    for (let row = 0; row < rows; row++) {
      let line = "";
      for (let column = 0; column < columns; column++) {
        let coverage = 0;
        for (let part = 0; part < cellAspect; part++) coverage += pixels[((row * cellAspect + part) * sheet.width + column) * 4 + 3]! / 255;
        line += ramp[Math.min(ramp.length - 1, Math.floor((coverage / cellAspect) * ramp.length))];
      }
      lines.push(line.trimEnd());
    }
    real.dataset.text = lines.join("\n");
  }

  function measureAt(pen: CanvasRenderingContext2D, fontPx: number): number {
    pen.font = `${fontPx}px "Inter Variable", system-ui, sans-serif`;
    return pen.measureText(word).width;
  }

  document.fonts.ready.then(() => {
    for (const holder of document.querySelectorAll<HTMLElement>(".wordmark")) {
      drawWordmark(holder);
      watchCiphers(holder);
    }
  });
</script>

<style>
  .wordmark {
    height: calc(var(--rows) * 0.625rem);
    overflow: hidden;
    white-space: pre;
    font-family: var(--sl-font-mono);
    font-size: 0.5rem;
    line-height: 0.625rem;
    color: var(--frame-ink);
  }

  .wordmark :global(.cipher) {
    display: block;
  }
</style>
