---
import CipherText from "./CipherText.astro";

const columnsAcross = 120;
const wordAspect = 3.4;
---

<div class="wordmark-holder" aria-hidden="true" style={`--columns: ${columnsAcross}; --word-aspect: ${wordAspect}`}>
  <div class="wordmark">
    <CipherText text="" duration={1400} decorative />
    <span class="wordmark-dense"></span>
  </div>
</div>

<script>
  import { watchCiphers } from "../../effects/cipher.ts";

  const ramp = " .:-=+*#%@";
  const sparseCells = new RegExp(`[^${ramp.slice(ramp.indexOf("#"))}]`, "g");
  const word = "BB Box";
  const subrows = 2;

  function fittedFontPx(pen: CanvasRenderingContext2D, width: number, height: number): number {
    const tryAt = height * 0.9;
    pen.font = `${tryAt}px "Inter Variable", system-ui, sans-serif`;
    const metrics = pen.measureText(word);
    const inkHeight = metrics.actualBoundingBoxAscent + metrics.actualBoundingBoxDescent;
    return tryAt * Math.min((width * 0.98) / metrics.width, (height * 0.94) / Math.max(1, inkHeight));
  }

  function drawWordmark(holder: HTMLElement): void {
    const mark = holder.querySelector<HTMLElement>(".wordmark")!;
    const real = holder.querySelector<HTMLElement>(".cipher-real");
    if (!real) return;
    const style = getComputedStyle(mark);
    const probe = document.createElement("canvas").getContext("2d")!;
    probe.font = `${style.fontSize} ${style.fontFamily}`;
    const cellWidth = probe.measureText("0").width;
    const lineHeight = parseFloat(style.lineHeight);
    const columns = Math.floor(mark.clientWidth / cellWidth);
    const rows = Math.floor(mark.clientHeight / lineHeight);
    const sheet = document.createElement("canvas");
    sheet.width = columns;
    sheet.height = rows * subrows;
    const pen = sheet.getContext("2d", { willReadFrequently: true })!;
    const cellAspect = lineHeight / cellWidth / subrows;
    pen.setTransform(1, 0, 0, 1 / cellAspect, 0, 0);
    const fontPx = fittedFontPx(pen, sheet.width, sheet.height * cellAspect);
    pen.font = `${fontPx}px "Inter Variable", system-ui, sans-serif`;
    pen.fillStyle = "#ffffff";
    pen.textBaseline = "alphabetic";
    const metrics = pen.measureText(word);
    const inkHeight = metrics.actualBoundingBoxAscent + metrics.actualBoundingBoxDescent;
    pen.fillText(word, (sheet.width - metrics.width) / 2 - metrics.actualBoundingBoxLeft, (sheet.height * cellAspect + inkHeight) / 2 - metrics.actualBoundingBoxDescent);
    const pixels = pen.getImageData(0, 0, sheet.width, sheet.height).data;
    const lines: string[] = [];
    for (let row = 0; row < rows; row++) {
      let line = "";
      for (let column = 0; column < columns; column++) {
        let coverage = 0;
        for (let part = 0; part < subrows; part++) coverage += pixels[((row * subrows + part) * sheet.width + column) * 4 + 3]! / 255;
        line += ramp[Math.min(ramp.length - 1, Math.floor((coverage / subrows) * ramp.length))];
      }
      lines.push(line.trimEnd());
    }
    real.dataset.text = lines.join("\n");
    mark.querySelector<HTMLElement>(".wordmark-dense")!.dataset.text = lines.map((line) => line.replace(sparseCells, " ")).join("\n");
  }

  document.fonts.ready.then(() => {
    for (const holder of document.querySelectorAll<HTMLElement>(".wordmark-holder")) {
      drawWordmark(holder);
      watchCiphers(holder);
    }
  });
</script>

<style>
  .wordmark-holder {
    container-type: inline-size;
  }

  .wordmark {
    position: relative;
    aspect-ratio: var(--word-aspect);
    overflow: hidden;
    white-space: pre;
    font-family: var(--sl-font-mono);
    font-size: calc(100cqw / var(--columns) / 0.6);
    line-height: 1.2;
    color: var(--wordmark-ink);
  }

  .wordmark :global(.cipher) {
    display: block;
  }

  .wordmark :global(.cipher-real) {
    display: block;
  }

  .wordmark-dense {
    position: absolute;
    inset: 0;
    color: var(--wordmark-dense);
    pointer-events: none;
  }

  .wordmark-dense::before {
    content: attr(data-text) / "";
  }

  .wordmark:has(:global([data-running])) .wordmark-dense {
    visibility: hidden;
  }
</style>
