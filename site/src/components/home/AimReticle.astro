<div class="aim" aria-hidden="true">
  <div class="ring">
    <span class="corner top-left"></span>
    <span class="corner top-right"></span>
    <span class="corner bottom-left"></span>
    <span class="corner bottom-right"></span>
    <span class="tick"></span>
  </div>
</div>

<script>
  import { cssValue, rgbOf } from "../../effects/gl.ts";
  import { aimFor, type AimShape } from "../../effects/aim.ts";

  const reticle = document.querySelector<HTMLElement>(".aim");
  const targets = "a[href], button:not([hidden]), label:has(> input[type=radio])";
  let aimed: { target: Element; y: number } | null = null;

  const isAccentFilled = (target: Element) => {
    const fill = getComputedStyle(target).backgroundColor;
    const parts = fill.match(/[\d.]+/g)?.map(Number) ?? [];
    if (parts.length < 3 || (parts.length === 4 && parts[3]! < 0.5)) return false;
    const accent = rgbOf(cssValue(document.documentElement, "--accent-fill")).map((channel) => channel * 255);
    return Math.hypot(parts[0]! - accent[0]!, parts[1]! - accent[1]!, parts[2]! - accent[2]!) < 60;
  };

  const shapeOf = (target: Element): AimShape => (target.matches("a") && getComputedStyle(target).display === "inline" ? "underline" : "frame");

  function lineBox(target: Element, y: number): DOMRect | undefined {
    const lines = [...target.getClientRects()].filter((rect) => rect.width > 0 && rect.height > 0);
    return lines.find((rect) => y >= rect.top && y <= rect.bottom) ?? lines[0];
  }

  function place(target: Element, y: number): boolean {
    if (!reticle) return false;
    const box = lineBox(target, y);
    if (!box) return false;
    const shape = shapeOf(target);
    const aim = aimFor(shape, { left: box.left, top: box.top, width: box.width, height: box.height });
    reticle.dataset.shape = shape;
    reticle.toggleAttribute("data-on-accent", isAccentFilled(target));
    reticle.style.setProperty("--aim-x", `${aim.left}px`);
    reticle.style.setProperty("--aim-y", `${aim.top}px`);
    reticle.style.setProperty("--aim-width", `${aim.width}px`);
    reticle.style.setProperty("--aim-height", `${aim.height}px`);
    reticle.style.setProperty("--corner", `${aim.corner}px`);
    return true;
  }

  function lockOn(target: Element, y: number): void {
    if (!reticle) return;
    if (aimed === null) {
      reticle.dataset.jump = "";
      reticle.removeAttribute("data-locked");
      if (!place(target, y)) return;
      void reticle.offsetWidth;
      reticle.removeAttribute("data-jump");
    } else if (!place(target, y)) return;
    aimed = { target, y };
    reticle.dataset.locked = "";
  }

  function release(): void {
    aimed = null;
    reticle?.removeAttribute("data-locked");
  }

  if (reticle) {
    document.addEventListener("pointerover", (event) => {
      if (event.pointerType !== "mouse") return;
      const target = (event.target as Element).closest(targets);
      if (target) lockOn(target, event.clientY);
    });
    document.addEventListener("pointerout", (event) => {
      const from = (event.target as Element).closest(targets);
      const to = (event.relatedTarget as Element | null)?.closest(targets);
      if (from && from !== to) release();
    });
    document.addEventListener("focusin", (event) => {
      const target = (event.target as Element).closest(targets);
      if (target?.matches(":focus-visible")) lockOn(target, target.getBoundingClientRect().top);
    });
    document.addEventListener("focusout", release);
    document.addEventListener("click", () => aimed && requestAnimationFrame(() => aimed && place(aimed.target, aimed.y)));
    window.addEventListener("scroll", () => aimed && place(aimed.target, aimed.target.getBoundingClientRect().top + 1), { passive: true });
    window.addEventListener("resize", () => aimed && place(aimed.target, aimed.y));
  }
</script>

<style>
  .aim {
    --corner: 9px;
    --weight: 1.5px;
    --ink: var(--accent);
    --glide: 140ms cubic-bezier(0.2, 0.9, 0.3, 1);
    position: fixed;
    left: var(--aim-x, 0);
    top: var(--aim-y, 0);
    z-index: 30;
    width: var(--aim-width, 0);
    height: var(--aim-height, 0);
    pointer-events: none;
    transition: left var(--glide), top var(--glide), width var(--glide), height var(--glide);
  }

  .aim[data-on-accent] {
    --ink: var(--foreground);
  }

  .aim[data-jump] {
    transition: none;
  }

  .ring {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 90ms ease-out;
  }

  .aim[data-locked] .ring {
    opacity: 1;
    animation: brackets-close 150ms cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  @keyframes brackets-close {
    from {
      transform: scale(1.18);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .corner {
    position: absolute;
    width: var(--corner);
    height: var(--corner);
    border: 0 solid var(--ink);
  }

  .top-left {
    left: 0;
    top: 0;
    border-left-width: var(--weight);
    border-top-width: var(--weight);
  }

  .top-right {
    right: 0;
    top: 0;
    border-right-width: var(--weight);
    border-top-width: var(--weight);
  }

  .bottom-left {
    left: 0;
    bottom: 0;
    border-left-width: var(--weight);
    border-bottom-width: var(--weight);
  }

  .bottom-right {
    right: 0;
    bottom: 0;
    border-right-width: var(--weight);
    border-bottom-width: var(--weight);
  }

  .aim[data-shape="underline"] .top-left,
  .aim[data-shape="underline"] .top-right {
    display: none;
  }

  .aim[data-shape="underline"] .bottom-left,
  .aim[data-shape="underline"] .bottom-right {
    height: 100%;
  }

  .tick {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 3px;
    height: 3px;
    background: var(--ink);
    opacity: 0;
  }

  .aim[data-locked][data-shape="frame"] .tick {
    animation: tick-in 120ms ease-out 150ms forwards;
  }

  @keyframes tick-in {
    from {
      opacity: 0;
      transform: translate(-3px, 3px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aim,
    .ring {
      transition: none;
    }

    .aim[data-locked] .ring {
      animation: none;
    }

    .aim[data-locked][data-shape="frame"] .tick {
      animation: none;
      opacity: 1;
    }
  }

  @media (pointer: coarse) {
    .aim {
      display: none;
    }
  }
</style>
