---
import PieceIcon from "./PieceIcon.astro";

interface SampleBox {
  name: string;
  badges: string[];
  desktop: boolean;
  status: string;
  facts: [string, string][];
}

const boxes: SampleBox[] = [
  {
    name: "proud-crane",
    badges: ["Desktop", "Container"],
    desktop: true,
    status: "Ready in 0.8 s · BB machine in 4.6 s · 4 cores · 8 GiB",
    facts: [
      ["Kind", "Linux desktop"],
      ["Provider", "Docker"],
      ["Size", "4 cores · 8 GiB · 24 GiB disk"],
      ["Address", "192.0.2.24"],
    ],
  },
  {
    name: "clear-comet",
    badges: ["microVM"],
    desktop: false,
    status: "Ready in 1.4 s · BB machine in 9.2 s · 2 cores · 4 GiB · 32 GiB",
    facts: [
      ["Kind", "Linux"],
      ["Provider", "microsandbox"],
      ["Size", "2 cores · 4 GiB · 32 GiB disk"],
      ["Address", "192.0.2.31"],
    ],
  },
];
const mostBoxes = 4;
---

<div class="piece box-panel" data-box-panel data-most={mostBoxes}>
  <div class="panel-bar">
    <span class="panel-title">Boxes</span>
    <button type="button" class="piece-tool" data-new-box aria-label="New box"><PieceIcon name="plus" /></button>
  </div>
  <ul class="rows">
    {
      boxes.map((box) => (
        <li class="row" data-box={box.name}>
          <div class="row-main">
            <PieceIcon name="cube" class="row-glyph" />
            <button type="button" class="row-name" aria-expanded="false">
              <span class="name">{box.name}</span>
            </button>
            <span class="row-kind">Linux</span>
            {box.badges.map((badge) => (
              <span class="piece-badge">{badge}</span>
            ))}
            <span class="row-actions">
              {box.desktop && (
                <button type="button" class="piece-tool" data-act="desktop" aria-label={`Open ${box.name}'s desktop`}>
                  <PieceIcon name="monitor" />
                </button>
              )}
              <button type="button" class="piece-tool" data-act="terminal" aria-label={`Open ${box.name}'s terminal`}>
                <PieceIcon name="terminal" />
              </button>
              <button type="button" class="piece-tool" data-act="files" aria-label={`Open ${box.name}'s files`}>
                <PieceIcon name="folder" />
              </button>
              <button type="button" class="piece-tool" data-menu-for={box.name} aria-label={`More for ${box.name}`}>
                <PieceIcon name="more" />
              </button>
            </span>
          </div>
          <p class="row-status">
            <span class="piece-dot" data-state="ready" />
            <span class="status-words">{box.status}</span>
          </p>
          <dl class="row-facts" hidden>
            {box.facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))
    }
  </ul>
  <ul class="piece-menu row-menu" role="menu" hidden>
    <li role="none"><button type="button" role="menuitem" data-choice="snapshot"><PieceIcon name="camera" />Take a snapshot</button></li>
    <li role="none"><button type="button" role="menuitem" data-choice="resize"><PieceIcon name="resize" />Resize</button></li>
    <li role="none"><button type="button" role="menuitem" data-choice="fork"><PieceIcon name="fork" />Fork</button></li>
    <li role="none"><hr /></li>
    <li role="none"><button type="button" role="menuitem" data-choice="release"><PieceIcon name="release" />Release</button></li>
  </ul>
  <p class="piece-note" aria-live="polite">Select a box's name for its details, or try its buttons.</p>
  <template data-row-template>
    <li class="row" data-box="">
      <div class="row-main">
        <PieceIcon name="cube" class="row-glyph" />
        <button type="button" class="row-name" aria-expanded="false"><span class="name"></span></button>
        <span class="row-kind">Linux</span>
        <span class="piece-badge">Container</span>
        <span class="row-actions">
          <button type="button" class="piece-tool" data-act="terminal" aria-label="Open terminal"><PieceIcon name="terminal" /></button>
          <button type="button" class="piece-tool" data-act="files" aria-label="Open files"><PieceIcon name="folder" /></button>
          <button type="button" class="piece-tool" data-menu-for="" aria-label="More"><PieceIcon name="more" /></button>
        </span>
      </div>
      <p class="row-status">
        <span class="piece-dot" data-state="starting"></span>
        <span class="status-words">Starting…</span>
      </p>
      <dl class="row-facts" hidden>
        <div><dt>Kind</dt><dd>Linux</dd></div>
        <div><dt>Provider</dt><dd>Docker</dd></div>
        <div><dt>Size</dt><dd>2 cores · 4 GiB · 24 GiB disk</dd></div>
      </dl>
    </li>
  </template>
</div>

<script>
  import { pieceMenu } from "../../effects/piece-menu.ts";
  import { sampleBoxName } from "../../effects/sample-names.ts";
  import { reducedMotion } from "../../motion.ts";

  const startingMs = 900;


  const menuSays: Record<string, (name: string) => string> = {
    snapshot: (name) => `In BB, this saves ${name}'s disk as a snapshot you can restore with an undo.`,
    resize: (name) => `In BB, this gives ${name} more cores, memory or disk, live where its backend can.`,
    fork: (name) => `In BB, this makes a fresh box from ${name}'s snapshot, with its own identity.`,
  };

  function startPanel(panel: HTMLElement): void {
    const list = panel.querySelector<HTMLUListElement>(".rows")!;
    const note = panel.querySelector<HTMLElement>(".piece-note")!;
    const menu = panel.querySelector<HTMLElement>(".row-menu")!;
    const template = panel.querySelector<HTMLTemplateElement>("[data-row-template]")!;
    const most = Number(panel.dataset.most);
    let released: { row: HTMLElement; after: Element | null } | undefined;

    const say = (words: string) => {
      note.textContent = words;
    };
    const names = () => new Set([...list.querySelectorAll<HTMLElement>(".row")].map((row) => row.dataset.box!));

    const placeMenu = (trigger: HTMLElement) => {
      const panelBox = panel.getBoundingClientRect();
      const box = trigger.getBoundingClientRect();
      menu.style.top = `${box.bottom - panelBox.top + 4}px`;
      menu.style.right = `${panelBox.right - box.right}px`;
    };

    const rowMenu = pieceMenu<HTMLElement>(
      menu,
      (choice, row) => {
        if (choice === "release") release(row);
        else say(menuSays[choice]!(row.dataset.box!));
      },
      placeMenu,
    );

    const wire = (row: HTMLElement) => {
      const name = row.dataset.box!;
      const toggle = row.querySelector<HTMLButtonElement>(".row-name")!;
      const facts = row.querySelector<HTMLElement>(".row-facts")!;
      toggle.addEventListener("click", () => {
        facts.hidden = !facts.hidden;
        toggle.setAttribute("aria-expanded", String(!facts.hidden));
        row.toggleAttribute("data-open", !facts.hidden);
      });
      row.querySelectorAll<HTMLButtonElement>("[data-act]").forEach((button) =>
        button.addEventListener("click", () => say(`In BB, this opens ${name}'s ${button.dataset.act} in a tab.`)),
      );
      rowMenu.attach(row.querySelector<HTMLButtonElement>("[data-menu-for]")!, row);
    };

    const release = (row: HTMLElement) => {
      released = { row, after: row.nextElementSibling };
      row.remove();
      note.replaceChildren(`Released ${row.dataset.box}. In BB, this deletes the box and its disk. `);
      const undo = document.createElement("button");
      undo.type = "button";
      undo.className = "note-undo";
      undo.textContent = "Undo";
      undo.addEventListener("click", () => {
        if (!released) return;
        list.insertBefore(released.row, released.after && released.after.parentElement === list ? released.after : null);
        say(`${released.row.dataset.box} is back.`);
        released = undefined;
      });
      note.append(undo);
    };

    const ready = (row: HTMLElement, seconds: string) => {
      row.querySelector(".piece-dot")!.setAttribute("data-state", "ready");
      row.querySelector(".status-words")!.textContent = `Ready in ${seconds} s · BB machine in 3.9 s · 2 cores · 4 GiB`;
    };

    panel.querySelector<HTMLButtonElement>("[data-new-box]")!.addEventListener("click", () => {
      if (list.children.length >= most) {
        say(`This sample keeps ${most} boxes. Release one to make another.`);
        return;
      }
      const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const name = sampleBoxName(names());
      row.dataset.box = name;
      row.querySelector(".name")!.textContent = name;
      row.querySelectorAll<HTMLButtonElement>("[data-act], [data-menu-for]").forEach((button) => {
        const what = button.dataset.act ? `Open ${name}'s ${button.dataset.act}` : `More for ${name}`;
        button.setAttribute("aria-label", what);
      });
      list.append(row);
      wire(row);
      say(`Making ${name}. In BB, a box is usually ready in seconds.`);
      if (reducedMotion()) ready(row, "0.9");
      else setTimeout(() => ready(row, "0.9"), startingMs);
    });

    list.querySelectorAll<HTMLElement>(".row").forEach(wire);
  }

  for (const panel of document.querySelectorAll<HTMLElement>("[data-box-panel]")) startPanel(panel);
</script>

<style>
  .box-panel {
    position: relative;
    padding: 0.25rem 0 0;
  }

  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.25rem 0.5rem 0.75rem;
  }

  .panel-title {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    padding: 0.625rem 0.5rem 0.625rem 0.75rem;
    border: 1px solid var(--border);
  }

  .row[data-open] {
    background: var(--surface);
  }

  .row-main {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem 0.5rem;
  }

  .row-main :global(.row-glyph) {
    color: var(--muted-foreground);
  }

  .row-name {
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 0.9375rem;
  }

  .row-name:hover .name {
    text-decoration: underline;
    text-decoration-color: var(--muted-foreground);
    text-underline-offset: 3px;
  }

  .row-kind {
    color: var(--muted-foreground);
  }

  .row-actions {
    display: inline-flex;
    gap: 0.125rem;
    margin-left: auto;
  }

  .row-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.25rem 0 0 1.5rem;
    color: var(--muted-foreground);
  }

  .row-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 0.75rem 0 0.25rem 1.5rem;
  }

  .row-facts[hidden] {
    display: none;
  }

  .row-facts dt {
    font-size: 0.6875rem;
    color: var(--muted-foreground);
  }

  .row-facts dd {
    margin: 0;
  }

  .row-menu {
    right: 0;
  }

  .piece-note :global(.note-undo) {
    margin-left: 0.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 40rem) {
    .row-actions {
      margin-left: 0;
      width: 100%;
      padding-left: 1.125rem;
    }

    .row-status {
      align-items: flex-start;
    }
  }
</style>
