---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<canvas class:list={["hero-field", className]} data-motion aria-hidden="true"></canvas>

<script>
  import { cssNumber, cssValue, deviceScale, drawnInSoftware, linkedProgram, noiseSource, quad, quadVertexSource, releaseGl, rgbOf, texture, uniformsOf, type Rgb } from "../../effects/gl.ts";
  import { stillFieldValue } from "../../effects/still-field.ts";
  import { animateWhileSeen, announceMotionChange } from "../../motion.ts";

  const ramp = " .·:-=+*%#";
  const glyphFontPx = 12;
  const glyphLinePx = 14;
  const pointerReachPx = 190;
  const presenceEase = 0.12;

  const fieldSource = `
    precision mediump float;
    uniform vec2 grid;
    uniform vec2 cellSize;
    uniform float seconds;
    uniform float scroll;
    uniform vec2 pointer;
    uniform float presence;
    uniform float lowest;
    uniform float quietLeft;
    uniform float leftFloor;
    ${noiseSource}
    void main() {
      vec2 cell = gl_FragCoord.xy;
      vec2 position = cell * cellSize;
      vec2 uv = position / (grid.y * cellSize.y);
      float t = seconds * 0.045;
      vec2 drift = vec2(t, t * 0.35 - scroll * 0.9);
      vec2 warp = vec2(layered(uv * 1.3 + drift), layered(uv * 1.3 + vec2(5.2, 1.3) - drift));
      float far = smoothstep(lowest, 0.82, layered(uv * 1.05 + warp * 1.7 + drift * 0.4));
      float near = smoothstep(0.58, 0.92, layered(uv * 3.1 + warp * 0.9 - drift * 1.6));
      float height = gl_FragCoord.y / grid.y;
      float value = far * 0.8 + near * 0.45;
      float sweep = 1.0 - fract(seconds * 0.06);
      value += 0.28 * exp(-pow((height - sweep) * 16.0, 2.0)) * (0.25 + value);
      value *= smoothstep(0.0, 0.75, height);
      float across = gl_FragCoord.x / grid.x;
      value *= mix(1.0, leftFloor + (1.0 - leftFloor) * smoothstep(0.1, 0.7, across), quietLeft);
      float away = distance(position, pointer);
      float lens = presence * exp(-(away * away) / (2.0 * ${pointerReachPx.toFixed(1)} * ${pointerReachPx.toFixed(1)}));
      float churn = hash(floor(cell) + floor(seconds * (1.2 + 16.0 * lens)));
      gl_FragColor = vec4(clamp(value + lens * 0.8, 0.0, 1.0), lens, churn, 1.0);
    }
  `;

  const glyphSource = `
    precision mediump float;
    uniform sampler2D field;
    uniform sampler2D atlas;
    uniform vec2 grid;
    uniform vec2 cellDevice;
    uniform float glyphs;
    uniform vec3 ink;
    uniform vec3 hot;
    uniform vec3 paper;
    uniform float strength;
    void main() {
      vec2 cell = floor(gl_FragCoord.xy / cellDevice);
      vec2 local = fract(gl_FragCoord.xy / cellDevice);
      vec4 here = texture2D(field, (cell + 0.5) / grid);
      float level = floor(clamp(here.r + (here.b - 0.5) * (0.1 + 0.5 * here.g), 0.0, 0.999) * glyphs);
      float glyph = texture2D(atlas, vec2((level + local.x) / glyphs, 1.0 - local.y)).a;
      float amount = glyph * (strength * (0.35 + 0.65 * here.r) + 0.45 * here.g);
      gl_FragColor = vec4(mix(paper, mix(ink, hot, here.g), clamp(amount, 0.0, 1.0)), 1.0);
    }
  `;

  interface Look {
    ink: Rgb;
    hot: Rgb;
    paper: Rgb;
    strength: number;
    lowest: number;
    leftFloor: number;
  }

  const lookOf = (canvas: HTMLCanvasElement): Look => ({
    ink: rgbOf(cssValue(canvas, "--dither-ink")),
    hot: rgbOf(cssValue(canvas, "--field-hot")),
    paper: rgbOf(cssValue(canvas, "--dither-paper")),
    strength: cssNumber(canvas, "--dither-strength", 0.4),
    lowest: cssNumber(canvas, "--dither-floor", 0.3),
    leftFloor: cssNumber(canvas, "--field-left", 0.3),
  });

  function glyphSheet(cellWidth: number, cellHeight: number, scale: number): HTMLCanvasElement {
    const sheet = document.createElement("canvas");
    sheet.width = cellWidth * ramp.length;
    sheet.height = cellHeight;
    const pen = sheet.getContext("2d")!;
    pen.fillStyle = "#ffffff";
    pen.font = `${glyphFontPx * scale}px "JetBrains Mono Variable", ui-monospace, monospace`;
    pen.textAlign = "center";
    pen.textBaseline = "middle";
    [...ramp].forEach((glyph, index) => pen.fillText(glyph, index * cellWidth + cellWidth / 2, cellHeight / 2 + scale));
    return sheet;
  }

  const quietLeftFor = (cssWidth: number) => (cssWidth > 900 ? 1 : 0.6);

  function drawStillIn2d(canvas: HTMLCanvasElement): void {
    const look = lookOf(canvas);
    const fresh = canvas.cloneNode() as HTMLCanvasElement;
    fresh.removeAttribute("data-motion");
    canvas.replaceWith(fresh);
    announceMotionChange();
    const pen = fresh.getContext("2d");
    if (!pen) {
      fresh.hidden = true;
      return;
    }
    const { width, height } = fresh.getBoundingClientRect();
    fresh.width = Math.max(1, Math.round(width));
    fresh.height = Math.max(1, Math.round(height));
    pen.font = `${glyphFontPx}px "JetBrains Mono Variable", ui-monospace, monospace`;
    pen.textBaseline = "top";
    const cellWidth = pen.measureText("0").width;
    const columns = Math.ceil(width / cellWidth);
    const rows = Math.ceil(height / glyphLinePx);
    const quietLeft = quietLeftFor(width);
    const [r, g, b] = look.ink.map((channel) => Math.round(channel * 255));
    const levels = [...ramp].map(() => [] as string[]);
    for (let row = 0; row < rows; row++) {
      const lines = levels.map(() => Array<string>(columns).fill(" "));
      for (let column = 0; column < columns; column++) {
        const value = stillFieldValue(column, rows - 1 - row, columns, rows, cellWidth / glyphLinePx, { lowest: look.lowest, quietLeft, leftFloor: look.leftFloor });
        const level = Math.floor(Math.min(0.999, value) * ramp.length);
        if (level > 0) lines[level]![column] = ramp[level]!;
      }
      lines.forEach((line, level) => levels[level]!.push(line.join("")));
    }
    levels.forEach((lines, level) => {
      if (level === 0) return;
      const value = (level + 0.5) / ramp.length;
      pen.fillStyle = `rgb(${r} ${g} ${b} / ${(look.strength * (0.35 + 0.65 * value)).toFixed(3)})`;
      lines.forEach((line, row) => pen.fillText(line, 0, row * glyphLinePx));
    });
  }

  function giveUp(canvas: HTMLCanvasElement, gl: WebGLRenderingContext | null, made: Parameters<typeof releaseGl>[1]): void {
    releaseGl(gl, made);
    drawStillIn2d(canvas);
  }

  function startField(canvas: HTMLCanvasElement): void {
    const gl = canvas.getContext("webgl", { antialias: false, alpha: false });
    const fieldProgram = gl ? linkedProgram(gl, quadVertexSource, fieldSource) : undefined;
    const glyphProgram = gl ? linkedProgram(gl, quadVertexSource, glyphSource) : undefined;
    const corners = gl && fieldProgram && glyphProgram ? quad(gl) : null;
    const fieldTexture = gl && corners ? texture(gl, gl.NEAREST) : null;
    const atlasTexture = gl && corners ? texture(gl, gl.NEAREST) : null;
    const frame = gl && corners ? gl.createFramebuffer() : null;
    const made = { programs: [fieldProgram, glyphProgram], buffers: [corners], textures: [fieldTexture, atlasTexture], framebuffers: [frame] };
    if (!gl || !fieldProgram || !glyphProgram || !corners || !fieldTexture || !atlasTexture || !frame || drawnInSoftware(gl)) {
      giveUp(canvas, gl, made);
      return;
    }
    let lost = false;
    canvas.addEventListener("webglcontextlost", () => {
      if (lost) return;
      lost = true;
      giveUp(canvas, gl, made);
    });
    const fieldUniforms = uniformsOf(gl, fieldProgram, ["grid", "cellSize", "seconds", "scroll", "pointer", "presence", "lowest", "quietLeft", "leftFloor"] as const);
    const glyphUniforms = uniformsOf(gl, glyphProgram, ["field", "atlas", "grid", "cellDevice", "glyphs", "ink", "hot", "paper", "strength"] as const);
    const hero = canvas.closest("section") ?? canvas;
    let look = lookOf(canvas);
    let columns = 1;
    let rows = 1;
    let cellCss = { width: 7.2, height: glyphLinePx };
    let cellDevice = { width: 7, height: glyphLinePx };
    let pointer = { x: -9999, y: -9999 };
    let pointerWanted = 0;
    let presence = 0;

    const scaleNow = deviceScale;

    const resize = () => {
      const scale = scaleNow();
      const { width, height } = canvas.getBoundingClientRect();
      const measure = document.createElement("canvas").getContext("2d")!;
      measure.font = `${glyphFontPx}px "JetBrains Mono Variable", ui-monospace, monospace`;
      cellCss = { width: measure.measureText("0").width, height: glyphLinePx };
      cellDevice = { width: Math.max(1, Math.round(cellCss.width * scale)), height: Math.round(cellCss.height * scale) };
      canvas.width = Math.max(1, Math.round(width * scale));
      canvas.height = Math.max(1, Math.round(height * scale));
      columns = Math.ceil(canvas.width / cellDevice.width);
      rows = Math.ceil(canvas.height / cellDevice.height);
      gl.bindTexture(gl.TEXTURE_2D, fieldTexture);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, columns, rows, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
      gl.bindFramebuffer(gl.FRAMEBUFFER, frame);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, fieldTexture, 0);
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.bindTexture(gl.TEXTURE_2D, atlasTexture);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, glyphSheet(cellDevice.width, cellDevice.height, scale));
    };

    const restyle = () => {
      look = lookOf(canvas);
    };

    const scrollShare = () => {
      const box = hero.getBoundingClientRect();
      return Math.min(1, Math.max(0, -box.top / Math.max(1, box.height)));
    };

    const draw = (seconds: number) => {
      if (lost || gl.isContextLost()) return;
      presence += (pointerWanted - presence) * presenceEase;
      const quietLeft = quietLeftFor(canvas.width / scaleNow());
      gl.bindFramebuffer(gl.FRAMEBUFFER, frame);
      gl.viewport(0, 0, columns, rows);
      gl.useProgram(fieldProgram);
      gl.uniform2f(fieldUniforms.grid, columns, rows);
      gl.uniform2f(fieldUniforms.cellSize, cellCss.width, cellCss.height);
      gl.uniform1f(fieldUniforms.seconds, seconds + 40);
      gl.uniform1f(fieldUniforms.scroll, scrollShare());
      gl.uniform2f(fieldUniforms.pointer, pointer.x, pointer.y);
      gl.uniform1f(fieldUniforms.presence, presence);
      gl.uniform1f(fieldUniforms.lowest, look.lowest);
      gl.uniform1f(fieldUniforms.quietLeft, quietLeft);
      gl.uniform1f(fieldUniforms.leftFloor, look.leftFloor);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.useProgram(glyphProgram);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, fieldTexture);
      gl.activeTexture(gl.TEXTURE1);
      gl.bindTexture(gl.TEXTURE_2D, atlasTexture);
      gl.uniform1i(glyphUniforms.field, 0);
      gl.uniform1i(glyphUniforms.atlas, 1);
      gl.uniform2f(glyphUniforms.grid, columns, rows);
      gl.uniform2f(glyphUniforms.cellDevice, cellDevice.width, cellDevice.height);
      gl.uniform1f(glyphUniforms.glyphs, ramp.length);
      gl.uniform3fv(glyphUniforms.ink, look.ink);
      gl.uniform3fv(glyphUniforms.hot, look.hot);
      gl.uniform3fv(glyphUniforms.paper, look.paper);
      gl.uniform1f(glyphUniforms.strength, look.strength);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };

    hero.addEventListener("pointermove", (event) => {
      const pointerEvent = event as PointerEvent;
      if (pointerEvent.pointerType !== "mouse") return;
      const box = canvas.getBoundingClientRect();
      pointer = { x: pointerEvent.clientX - box.left, y: box.bottom - pointerEvent.clientY };
      pointerWanted = 1;
    });
    hero.addEventListener("pointerleave", () => {
      pointerWanted = 0;
    });

    document.fonts.ready.then(() => {
      resize();
      draw(0);
    });
    resize();
    animateWhileSeen(canvas, { draw, resize, restyle }, 24);
  }

  function startWhenIdle(): void {
    for (const canvas of document.querySelectorAll<HTMLCanvasElement>("canvas.hero-field")) startField(canvas);
  }

  if ("requestIdleCallback" in window) requestIdleCallback(startWhenIdle, { timeout: 400 });
  else setTimeout(startWhenIdle, 200);
</script>

<style>
  .hero-field {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-field[hidden] {
    display: none;
  }
</style>
