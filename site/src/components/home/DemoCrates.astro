<div class="crates" data-motion aria-hidden="true" hidden></div>

<script>
  import type { Landing } from "../../effects/crates.ts";
  import { onMotionChange, pausedByPerson, reducedMotion } from "../../motion.ts";

  const layer = document.querySelector<HTMLElement>(".crates");
  const shelf = document.querySelector(".demo .frame-top");
  const floor = document.querySelector(".foot-inner");
  const strip = document.querySelector<HTMLElement>(".dither-strip");
  const dotPitchPx = 6;

  const ripple = ({ pageX, speed }: Landing) => {
    if (!strip) return;
    const box = strip.getBoundingClientRect();
    const width = Math.min(360, Math.max(120, speed * 26));
    const left = pageX - (box.left + scrollX) - width / 2;
    const ring = document.createElement("span");
    ring.className = "strip-ripple";
    ring.style.left = `${left}px`;
    ring.style.width = `${width}px`;
    ring.style.backgroundPositionX = `${-(((left % dotPitchPx) + dotPitchPx) % dotPitchPx)}px`;
    ring.addEventListener("animationend", () => ring.remove());
    strip.append(ring);
  };
  const roomToBash = matchMedia("(hover: hover) and (pointer: fine) and (min-width: 48rem)");
  const motionAllowed = () => roomToBash.matches && !reducedMotion() && !pausedByPerson();

  if (layer && shelf && floor) {
    document.body.append(layer);
    let started = false;

    const start = async () => {
      if (started || !motionAllowed()) return;
      started = true;
      await document.fonts.ready;
      const { stackCrates } = await import("../../effects/crates.ts");
      layer.hidden = false;
      const crates = stackCrates(layer, shelf, floor, motionAllowed(), ripple);
      crates.setActive(motionAllowed());
      const follow = () => crates.setActive(motionAllowed());
      onMotionChange(follow);
      roomToBash.addEventListener("change", follow);
    };

    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void start();
      },
      { rootMargin: "200px" },
    ).observe(shelf);
    onMotionChange(() => void start());
    roomToBash.addEventListener("change", () => void start());
  }
</script>

