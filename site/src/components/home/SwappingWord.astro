---
interface Props {
  words: string[];
}

const { words } = Astro.props;
---

<span class="swap" data-words={JSON.stringify(words)}>{words[0]}</span>

<script>
  import { cipherDuration, cipherFrame, letterGlyphsFor, revealTimes } from "../../effects/cipher-text.ts";
  import { animateWhileSeen, pausedByPerson, reducedMotion } from "../../motion.ts";

  const holdSeconds = 1.6;
  const escaped = (glyph: string) => (glyph === "<" ? "&lt;" : glyph === ">" ? "&gt;" : glyph === "&" ? "&amp;" : glyph);

  for (const swap of document.querySelectorAll<HTMLElement>(".swap[data-words]")) {
    const words: string[] = JSON.parse(swap.dataset.words ?? "[]");
    if (words.length < 2) continue;
    const scrambleSeconds = words.map((word) => cipherDuration(word) / 1000);
    const revealAt = words.map((word, index) => revealTimes(word, scrambleSeconds[index]! * 1000, Math.random));
    const cycleSeconds = words.reduce((sum, _, index) => sum + holdSeconds + scrambleSeconds[index]!, 0);
    let shown = "";

    const show = (html: string) => {
      if (html === shown) return;
      shown = html;
      swap.innerHTML = html;
    };

    animateWhileSeen(
      swap,
      {
        draw(seconds) {
          const settled = reducedMotion() || pausedByPerson();
          let into = seconds % cycleSeconds;
          for (let index = 0; index < words.length; index++) {
            if (into < scrambleSeconds[index]! && !settled) {
              const pieces = cipherFrame(words[index]!, into * 1000, revealAt[index]!, letterGlyphsFor, Math.random);
              show(pieces.map((piece) => (piece.settled ? escaped(piece.glyph) : `<span class="swap-glyph">${escaped(piece.glyph)}</span>`)).join(""));
              return;
            }
            into -= scrambleSeconds[index]!;
            if (into < holdSeconds || settled) {
              show(escaped(words[index]!));
              return;
            }
            into -= holdSeconds;
          }
        },
      },
      30,
    );
  }
</script>

<style>
  .swap {
    display: block;
  }

  .swap :global(.swap-glyph) {
    color: var(--accent);
  }
</style>
