---
import { Image } from "astro:assets";
import type { Shot } from "../../home.ts";

interface Props {
  shot: Shot;
  class?: string;
  widths?: number[];
  sizes?: string;
}

const { shot, class: className, widths = [640, 960, 1280, 1920], sizes = "(min-width: 1100px) 720px, 100vw" } = Astro.props;
const sameInBothThemes = shot.dark === shot.light;
const framing = `--focus-x: ${shot.focus.x}%; --focus-y: ${shot.focus.y}%; --zoom: ${shot.focus.zoom}`;
---

<span class:list={["themed-shot", className]} style={framing}>
  <Image class="shot-dark" src={shot.dark} alt={shot.alt} widths={widths} sizes={sizes} format="webp" quality={82} loading="lazy" decoding="async" />
  {!sameInBothThemes && <Image class="shot-light" src={shot.light} alt={shot.alt} widths={widths} sizes={sizes} format="webp" quality={82} loading="lazy" decoding="async" />}
</span>

<style>
  .themed-shot {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .themed-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus-x) var(--focus-y);
    transform: scale(var(--zoom));
    transform-origin: var(--focus-x) var(--focus-y);
  }

  .shot-light {
    display: none !important;
  }

  :global([data-theme="light"]) .shot-light {
    display: block !important;
  }

  :global([data-theme="light"]) .shot-dark:has(+ .shot-light) {
    display: none !important;
  }
</style>
