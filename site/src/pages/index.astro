---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/theme.css";
import "../styles/pieces.css";
import BoxFrame from "../components/home/BoxFrame.astro";
import CopyButton from "../components/home/CopyButton.astro";
import DemoVideo from "../components/home/DemoVideo.astro";
import AsciiWordmark from "../components/home/AsciiWordmark.astro";
import CipherText from "../components/home/CipherText.astro";
import GlyphRain from "../components/home/GlyphRain.astro";
import GlyphRule from "../components/home/GlyphRule.astro";
import HeroField from "../components/home/HeroField.astro";
import PointerBox from "../components/home/PointerBox.astro";
import HomeHead from "../components/home/HomeHead.astro";
import AimReticle from "../components/home/AimReticle.astro";
import MotionToggle from "../components/home/MotionToggle.astro";
import BoxPanelPiece from "../components/home/BoxPanelPiece.astro";
import DesktopPiece from "../components/home/DesktopPiece.astro";
import MonitorPiece from "../components/home/MonitorPiece.astro";
import NewBoxPiece from "../components/home/NewBoxPiece.astro";
import RecordingPiece from "../components/home/RecordingPiece.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { demoSeconds } from "../demo.ts";
import { homePageHead } from "../head.ts";
import { headline, homeData, platformLines, platformNames, subline, tagline } from "../home.ts";
import { pageUrl } from "../repo.ts";

const base = import.meta.env.BASE_URL;
const data = await homeData(base, Astro.site);
const shown = data.features.filter((feature) => feature.piece);
const listed = data.features.filter((feature) => !feature.piece);
const page = {
  title: "BB Box",
  description: tagline,
  head: homePageHead,
};
const docs = pageUrl(base, "start");
const acquire = "bb box acquire linux-desktop-cpu";
const markDelay = (row: number, column: number) => row * 70 + column * 35;
import { Image } from "astro:assets";
import appIcon from "../assets/app-icon.png";
---

<html lang="en" dir="ltr">
  <head>
    <HomeHead {...page} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar dither-screen">
      <div class="bar-inner">
      <a class="brand" href={base}>
        <Image class="mark" src={appIcon} alt="" width={24} height={24} densities={[1, 2, 3]} format="png" loading="eager" />
        BB Box
      </a>
      <nav aria-label="Site">
        <a href={docs}>Docs</a>
        <a href={pageUrl(base, "reference")}>Reference</a>
        <a href={data.repository}>GitHub</a>
        <ThemeToggle />
      </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="headline">
        <div class="field"><HeroField /></div>
        <div class="hero-copy">
          <p class="session dither-screen">
            <span class="line"><span class="prompt-sign" aria-hidden="true">$</span> <span class="typed" style={`--chars: ${acquire.length}`}>{acquire}</span></span>
            <span class="line reply"><span class="ready" aria-hidden="true">●</span> Ready in seconds, and a warm box at once.</span>
          </p>
          <h1 id="headline">{headline}</h1>
          <p class="lead">{subline}</p>
          <div class="actions">
            <CopyButton source="setup-prompt" class="button primary" label="Copy setup prompt" />
            <a class="button secondary" href={data.quickStart}>Quick start</a>
          </div>
        </div>
      </section>

      <section class="demo" aria-label="The demo">
        <BoxFrame title={`demo.mp4  ${demoSeconds} s`}>
          <div class="video-well"><DemoVideo /></div>
        </BoxFrame>
        <p class="caption">A thread's agent gets a Linux desktop, then a server box, a snapshot and an undo.</p>
      </section>

      <GlyphRule seed={1} />

      <section class="section" aria-labelledby="platforms">
        <div class="section-head">
          <a class="heading-mark" data-cipher-hover href="#platforms"><CipherText text="# platforms" /></a>
          <h2 id="platforms"><CipherText text="A computer of its own for every thread" glyphs="letters" /></h2>
        </div>
        <p class="section-lead">Boxes have the thread's Git access, its variables and BB itself. You and the agent share them: the agent works in the box, and you can open its desktop or terminal at any time.</p>
        <div class="platforms-grid">
          <ul class="tree">
            <li class="tree-root">boxes/</li>
            {platformNames.map((name, index) => (
              <li>
                <span class:list={["branch", { last: index === platformNames.length - 1 }]}></span>
                <span class="tree-name">{name}</span>
                <span class="tree-words">{platformLines[name]}</span>
              </li>
            ))}
          </ul>
          <BoxFrame title="box.txt" class="box-figure">
            <div class="box-stage"><PointerBox /></div>
          </BoxFrame>
        </div>
      </section>

      <GlyphRule seed={2.4} />

      <section class="section" aria-labelledby="features">
        <div class="section-head">
          <a class="heading-mark" data-cipher-hover href="#features"><CipherText text="# features" /></a>
          <h2 id="features"><CipherText text="Made for the way agents work" glyphs="letters" /></h2>
        </div>
        <ul class="shots">
          {shown.map((feature, index) => (
            <li class:list={{ wide: index === 0 }}>
              <BoxFrame title={feature.title}>
                {feature.piece !== "recording" && <span slot="action" class="piece-tag">try it</span>}
                {feature.piece === "boxPanel" && <BoxPanelPiece />}
                {feature.piece === "newBox" && <NewBoxPiece backends={data.backends} />}
                {feature.piece === "desktop" && <DesktopPiece />}
                {feature.piece === "recording" && <RecordingPiece />}
                {feature.piece === "monitor" && <MonitorPiece />}
              </BoxFrame>
              <p class="shot-words" set:html={feature.html} />
            </li>
          ))}
        </ul>
        <ul class="more-features">
          {listed.map((feature, index) => (
            <li>
              <span class:list={["branch", { last: index === listed.length - 1 }]}></span>
              <span>
                <span class="feature-title">{feature.title}.</span>{" "}
                <span class="feature-words" set:html={feature.html} />
              </span>
            </li>
          ))}
        </ul>
      </section>

      <GlyphRule seed={3.9} />

      <section class="section backends" aria-labelledby="backends">
        <div class="backends-intro">
          <div class="rain"><GlyphRain /></div>
          <div class="section-head">
            <a class="heading-mark" data-cipher-hover href="#backends"><CipherText text="# backends" /></a>
            <h2 id="backends"><CipherText text="Any provider, one interface" glyphs="letters" /></h2>
          </div>
          <p class="section-lead">Docker on the machine that runs BB to start with. Add Proxmox, microsandbox, Macs with Tart, machines over SSH, or rent from Hetzner Cloud, Namespace and boat.dev.</p>
        </div>
        <div class="table-scroll" role="region" aria-labelledby="backends" tabindex="0">
          <table class="listing">
            <thead>
              <tr>
                <th scope="col">backend</th>
                {platformNames.map((name) => <th scope="col" class="mark-col">{name.toLowerCase()}</th>)}
                <th scope="col" class="mark-col">snapshots</th>
              </tr>
            </thead>
            <tbody>
              {data.backends.map((backend, row) => (
                <tr>
                  <th scope="row">
                    <a href={backend.href}>{backend.name}</a>
                    <span class="where">{backend.where}</span>
                    <span class="runs-on">{platformNames.filter((name) => backend.runs[name]).join(" · ")}{backend.takesSnapshots ? " · snapshots" : ""}</span>
                  </th>
                  {[...platformNames.map((name) => backend.runs[name]), backend.takesSnapshots].map((yes, column) => (
                    <td class="mark-col">
                      <span class:list={[yes ? "yes" : "no"]}>
                        <span aria-hidden="true"><CipherText text={yes ? "[x]" : "[ ]"} delay={markDelay(row, column)} duration={460} decorative /></span>
                        <span class="sr-only">{yes ? "Yes" : "No"}</span>
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <GlyphRule seed={5.3} />

      <section class="section" aria-labelledby="install">
        <div class="section-head">
          <a class="heading-mark" data-cipher-hover href="#install"><CipherText text="# install" /></a>
          <h2 id="install"><CipherText text="Set it up with an agent" glyphs="letters" /></h2>
        </div>
        <p class="section-lead">Paste this into a BB thread. Its agent installs BB Box, sets up a backend and proves it with a box.</p>
        <div class="install">
          <BoxFrame title="setup prompt" class="prompt-frame">
            <CopyButton slot="action" source="setup-prompt" class="frame-button" label="Copy" />
            <pre id="setup-prompt" class="prompt">{data.prompt}</pre>
          </BoxFrame>
          <div class="by-hand">
            <h3>Or by hand</h3>
            <div class="command">
              <span class="prompt-sign" aria-hidden="true">$</span>
              <code id="install-command">{data.command}</code>
              <CopyButton source="install-command" class="frame-button" label="Copy" />
            </div>
            <h3>What each platform needs</h3>
            <ul class="needs">
              {data.requirements.map((need) => (
                <li>
                  <span class="need-title">{need.title}</span>
                  <span set:html={need.html} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </main>

    <AimReticle />
    <footer class="foot">
      <div class="dither-strip" aria-hidden="true"></div>
      <div class="foot-inner">
        <AsciiWordmark />
        <ul class="ways">
          {data.links.map((link) => (
            <li>
              <a href={link.href}><span class="arrow" aria-hidden="true">→</span>{link.title}</a>
              <span>{link.words}</span>
            </li>
          ))}
        </ul>
        <p class="fine">
          <a href={data.repository}>GitHub</a>
          <a href={`${base.replace(/\/?$/, "/")}llms.txt`}>llms.txt</a>
          <a href={data.licence}>MIT licence</a>
          <a href={data.thirdParty}>Third-party software</a>
          <MotionToggle />
        </p>
      </div>
    </footer>
    <script>
      const bar = document.querySelector<HTMLElement>("header.bar");
      const topOfPage = document.createElement("div");
      topOfPage.style.cssText = "position:absolute;top:0;height:1px;width:1px";
      document.body.prepend(topOfPage);
      if (bar) new IntersectionObserver(([entry]) => bar.toggleAttribute("data-scrolled", !entry!.isIntersecting)).observe(topOfPage);
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scrollbar-gutter: auto;
    background: var(--background);
    color: var(--foreground);
    font-family: "Inter Variable", system-ui, sans-serif;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 0.75rem;
    background: var(--foreground);
    color: var(--background);
    z-index: 10;
  }

  .skip:focus {
    top: 0.75rem;
  }

  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    border-bottom: 1px solid transparent;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .bar.dither-screen::before {
    inset: 0 0 -2rem;
    opacity: 0;
    transition: opacity 200ms ease;
    mask-image:
      linear-gradient(90deg, #000, rgb(0 0 0 / 0.7) 30%, #000 55%, rgb(0 0 0 / 0.78) 80%, #000),
      linear-gradient(to bottom, #000 55%, transparent);
    mask-size: 50% 100%, 100% 100%;
    mask-repeat: repeat-x, no-repeat;
    mask-composite: intersect;
    animation-name: dither-drift-fading;
  }

  @keyframes dither-drift-fading {
    from {
      mask-position: 0% 0, 0 0;
    }
    to {
      mask-position: 200% 0, 0 0;
    }
  }

  .bar[data-scrolled]::before {
    opacity: 1;
  }

  .dither-screen {
    isolation: isolate;
  }

  .dither-screen::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: color-mix(in srgb, var(--background) 72%, transparent);
    background-image: repeating-conic-gradient(var(--background) 0 25%, transparent 0 50%);
    background-size: 2px 2px;
    mask-image: linear-gradient(90deg, #000, rgb(0 0 0 / 0.7) 30%, #000 55%, rgb(0 0 0 / 0.78) 80%, #000);
    mask-size: 50% 100%;
    mask-repeat: repeat-x;
    animation: dither-drift 14s linear infinite;
  }

  @keyframes dither-drift {
    from {
      mask-position: 0% 0;
    }
    to {
      mask-position: 200% 0;
    }
  }

  :global([data-motion="paused"]) .dither-screen::before {
    animation: none;
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 72rem;
    height: 4rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .mark {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 22%;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  nav a {
    padding: 0.5rem 0.625rem;
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.875rem;
  }

  nav a:hover {
    color: var(--foreground);
  }

  .hero {
    position: relative;
    padding: 10rem 1.5rem 5rem;
  }

  .field {
    position: absolute;
    inset: 0;
    mask-image: linear-gradient(to bottom, transparent 0, var(--foreground) 6.5rem, var(--foreground) 55%, transparent 100%);
  }

  .hero-copy {
    position: relative;
    max-width: 69rem;
    margin: 0 auto;
  }

  .session {
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0 0 2.5rem;
    padding: 0.75rem 1rem;
    position: relative;
    border-radius: 0;
    box-shadow: inset 0 0 0 1px var(--border);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--foreground);
  }

  .prompt-sign {
    color: var(--accent);
  }

  .typed {
    display: inline-block;
    max-width: calc(var(--chars) * 1ch);
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation: type-in 1.4s steps(var(--chars)) 0.4s both;
  }

  .reply {
    color: var(--muted-foreground);
    animation: appear 0s linear 2s both;
  }

  .ready {
    color: var(--accent);
  }

  @keyframes type-in {
    from {
      max-width: 0;
    }
  }

  @keyframes appear {
    from {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typed,
    .reply {
      animation: none;
    }

    .bar,
    .bar.dither-screen::before {
      transition: none;
    }

    .dither-screen::before {
      animation: none;
    }
  }

  :global([data-motion="paused"]) .typed,
  :global([data-motion="paused"]) .reply {
    animation: none;
  }


  h1 {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(2.5rem, 6vw + 0.5rem, 5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lead {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.25rem;
  }

  :global(.button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.25rem;
    border: 0;
    border-radius: 0;
    font-size: 0.9375rem;
    text-decoration: none;
    cursor: pointer;
  }

  :global(.button.primary) {
    background: var(--accent-fill);
    color: var(--accent-ink);
    transition: background-color 120ms ease-out;
  }

  :global(.button.primary:hover) {
    background: color-mix(in oklab, var(--accent-fill) 84%, var(--foreground));
  }

  .button.secondary {
    background: var(--muted-strong);
    color: var(--foreground);
    transition: background-color 120ms ease-out;
  }

  .button.secondary:hover {
    background: color-mix(in oklab, var(--muted-strong) 84%, var(--foreground));
  }

  :global(.frame-button) {
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    cursor: pointer;
  }

  :global(.frame-button:hover) {
    color: var(--foreground);
  }

  :global(.frame-button .copy-label)::before {
    content: "[ " / "";
  }

  :global(.frame-button .copy-label)::after {
    content: " ]" / "";
  }

  .demo,
  .section {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .video-well {
    padding: 0.5rem 0 0.75rem;
  }

  .video-well :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .caption {
    margin: 0.75rem 0 0 1.2em;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .section {
    position: relative;
    padding-top: 3.5rem;
  }

  main > :global(.glyph-rule) {
    margin-top: 5rem;
  }

  .section-head {
    position: relative;
  }

  .heading-mark {
    display: inline-block;
    margin: 0 0 0.875rem;
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: none;
  }

  .heading-mark:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }

  .platforms-grid :global(.box-figure) {
    margin-top: 2.5rem;
  }

  .box-stage {
    height: 17rem;
  }

  .backends-intro {
    position: relative;
  }

  .backends-intro > :not(.rain) {
    position: relative;
    z-index: 1;
  }

  .rain {
    position: absolute;
    inset: -3.5rem 0 0 auto;
    width: 62%;
    mask-image: radial-gradient(ellipse 80% 90% at 78% 38%, var(--foreground) 20%, transparent 74%);
  }

  h2 {
    max-width: 44rem;
    margin: 0;
    scroll-margin-top: 6rem;
    font-size: clamp(1.75rem, 3vw + 0.75rem, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .section-lead {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .tree {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .tree {
    --branch-y: calc(0.375rem + 0.75em);
  }

  .tree li {
    position: relative;
    display: grid;
    grid-template-columns: 3.25em 7rem minmax(0, 1fr);
    align-items: baseline;
    padding: 0.375rem 0;
  }

  .tree-root {
    display: block !important;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .branch::before,
  .branch::after {
    content: "";
    position: absolute;
    left: 0.375em;
    border-color: var(--frame-ink);
    border-style: solid;
    border-width: 0;
  }

  .branch::before {
    top: 0;
    bottom: 0;
    border-left-width: 1px;
  }

  .branch::after {
    top: var(--branch-y);
    width: 1.75em;
    border-top-width: 1px;
  }

  .branch.last::before {
    bottom: auto;
    height: var(--branch-y);
  }

  .more-features li:first-child .branch::before {
    top: var(--branch-y);
  }

  .tree-words {
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 2rem;
    align-items: start;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .shots .wide {
    grid-column: 1 / -1;
  }

  .shot-words {
    max-width: 34rem;
    margin: 0.75rem 0 0 1.2em;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  .more-features {
    --branch-y: calc(0.3125rem + 0.775em);
    display: flex;
    flex-direction: column;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .more-features li {
    position: relative;
    display: grid;
    grid-template-columns: 3.25em minmax(0, 1fr);
    max-width: 48rem;
    padding: 0.3125rem 0;
  }

  .feature-words {
    color: var(--muted-foreground);
  }

  .trust {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  main :global(a:not(.button)) {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--muted-foreground);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  main :global(a:not(.button):hover) {
    text-decoration-color: var(--accent);
  }

  main :global(code) {
    font-family: var(--sl-font-mono);
    font-size: 0.875em;
  }

  .table-scroll {
    margin-top: 2.5rem;
    overflow-x: auto;
  }

  .listing {
    width: 100%;
