---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getEntry } from "astro:content";
import darkPoster from "../../../docs/media/demo-poster.jpg";
import darkVideo from "../../../docs/media/demo.mp4?url";
import lightPoster from "../../../docs/media/demo-light-poster.jpg";
import lightVideo from "../../../docs/media/demo-light.mp4?url";
import InstallBlock from "../components/InstallBlock.astro";
import { absoluteAddress, markdownPath } from "../llms.ts";
import { listUnder } from "../rendered.ts";
import { pageUrl, readPages } from "../repo.ts";
import { installCommand, quickStartOnGitHub, setupPrompt } from "../setup-prompt.ts";
import { startingPoints, trustNote } from "../starting-points.ts";

const base = import.meta.env.BASE_URL;
const introduction = await getEntry("docs", "start");
const reasons = listUnder(introduction?.rendered?.html ?? "", "why-bb-box");
const mark = `<svg class="mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z"/><path d="M3.8 7.2 12 11.8l8.2-4.6M12 11.8v9.5"/></svg>`;
const command = installCommand(readPages());
const quickStart = Astro.site ? absoluteAddress(markdownPath(base, "start/quick-start"), { base, site: Astro.site.href }) : quickStartOnGitHub(command);
---

<StarlightPage
  frontmatter={{
    title: "BB Box",
    description: "Computers for BB threads: Linux, Windows, macOS, iOS and Android, virtual or real: desktops, terminals or simulators, shared by you and your agent.",
    template: "splash",
    hero: {
      title: `${mark}BB Box`,
      tagline: "Computers for BB threads: Linux, Windows, macOS, iOS and Android, virtual or real: desktops, terminals or simulators, shared by you and your agent.",
    },
  }}
>
  <InstallBlock prompt={setupPrompt(readPages(), quickStart)} guide={pageUrl(base, "start/quick-start")} />

  <figure class="demo not-content">
    <video autoplay muted loop playsinline width={darkPoster.width} height={darkPoster.height} data-dark-src={darkVideo} data-dark-poster={darkPoster.src} data-light-src={lightVideo} data-light-poster={lightPoster.src} aria-label="A person asks a BB thread's agent for a Linux desktop box, and the agent opens getbb.app in its browser. The person opens the desktop, glances at the box's CPU and memory in the Monitor, then makes a server box and runs a command in its terminal. On the server box's page, the person takes a snapshot, breaks the box from its terminal, and restores the snapshot with an undo."></video>
    <script is:inline>
      (() => {
        const video = document.currentScript.previousElementSibling;
        const show = () => {
          const theme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
          if (video.dataset.shown === theme) return;
          const playedTo = video.currentTime;
          video.dataset.shown = theme;
          video.poster = video.dataset[`${theme}Poster`];
          video.src = playedTo ? `${video.dataset[`${theme}Src`]}#t=${playedTo.toFixed(2)}` : video.dataset[`${theme}Src`];
          video.play().catch(() => {});
        };
        show();
        new MutationObserver(show).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
      })();
    </script>
    <noscript>
      <video autoplay muted loop playsinline width={darkPoster.width} height={darkPoster.height} poster={darkPoster.src} src={darkVideo} aria-label="A person asks a BB thread's agent for a Linux desktop box, and the agent opens getbb.app in its browser. The person opens the desktop, glances at the box's CPU and memory in the Monitor, then makes a server box and runs a command in its terminal. On the server box's page, the person takes a snapshot, breaks the box from its terminal, and restores the snapshot with an undo."></video>
    </noscript>
  </figure>

  <section class="column not-content" aria-labelledby="why-bb-box">
    <h2 id="why-bb-box">Why BB Box</h2>
    <ul class="list">
      {reasons.map((reason) => (
        <li>
          <span class="dash" aria-hidden="true">-</span>
          <span>
            <span class="lead">{reason.title}.</span>{" "}
            <span class="words" set:html={reason.html} />
          </span>
        </li>
      ))}
    </ul>
    <p class="trust">{trustNote}</p>
  </section>

  <section class="column not-content" aria-labelledby="find-your-way">
    <h2 id="find-your-way">Find your way</h2>
    <ul class="list">
      {startingPoints.map((way) => (
        <li>
          <span class="dash" aria-hidden="true">-</span>
          <span>
            <a class="lead link" href={pageUrl(base, way.id)}>{way.title}</a>{". "}
            <span class="words">{way.words}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>
</StarlightPage>

<style>
  :global([data-has-hero] .site-title) {
    visibility: hidden;
  }

  :global([data-has-hero] button[data-open-modal]) {
    display: none;
  }

  :global([data-has-hero] header.header) {
    position: absolute;
    border-bottom-color: transparent;
    background-color: transparent;
  }

  :global([data-has-hero] .main-frame) {
    padding-top: 0;
  }

  :global([data-has-hero] header .right-group) {
    display: flex;
  }

  :global([data-has-hero] .hero) {
    display: block;
    max-width: 42rem;
    margin-inline: auto;
    padding: 4rem 0 0;
  }

  :global([data-has-hero] .hero .stack),
  :global([data-has-hero] .hero .copy) {
    align-items: flex-start;
    text-align: start;
    gap: 0;
  }

  :global([data-has-hero] .hero h1) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    line-height: 1.75rem;
    color: var(--foreground);
  }

  :global([data-has-hero] .hero h1 .mark) {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }

  :global([data-has-hero] .hero .tagline) {
    max-width: none;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  .demo {
    max-width: 67.5rem;
    margin: 3rem auto 0;
    padding: 6px;
    border-radius: 14px;
    background-color: var(--muted);
  }

  .demo video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .column {
    max-width: 42rem;
    margin: 3rem auto 0;
  }

  .column h2 {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500 !important;
    color: var(--muted-foreground);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.275;
  }

  .list li {
    display: flex;
    gap: 0.75rem;
    margin: 0;
  }

  .dash {
    flex-shrink: 0;
    color: var(--muted-foreground);
  }

  .lead {
    color: var(--foreground);
  }

  .words {
    color: var(--muted-foreground);
  }

  .list :global(a) {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--muted-foreground);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .list :global(a:hover) {
    text-decoration-color: var(--foreground);
  }

  .list a.link {
    color: var(--foreground);
  }

  .trust {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--muted-foreground);
  }
</style>
