{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@novnc/novnc/core/*": [
        "./node_modules/@novnc/novnc/core/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "host.ts",
    "app.tsx",
    "vitest.config.ts",
    "src",
    "test",
    "scripts",
    "components",
    "lib"
  ]
}
