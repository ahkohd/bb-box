#!/bin/sh
# bb-box: make this box's VNC password once, on its first boot. The plugin
# reads the plain password from /var/lib/bb-box/vnc-password over SSH.
# usage: vnc-password <box-user>
set -eu
user=$1
dir=/var/lib/bb-box
[ -s "$dir/vnc.passwd" ] && exit 0
umask 027
install -d -m 0750 -g "$user" "$dir"
pw=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
printf '%s\n' "$pw" >"$dir/vnc-password.tmp"
printf '%s\n' "$pw" | tigervncpasswd -f >"$dir/vnc.passwd.tmp"
chgrp "$user" "$dir/vnc-password.tmp" "$dir/vnc.passwd.tmp"
mv "$dir/vnc-password.tmp" "$dir/vnc-password"
mv "$dir/vnc.passwd.tmp" "$dir/vnc.passwd"
