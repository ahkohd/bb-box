#!/bin/bash
# bb-box: the Wayland desktop's display (048): Sway, headless, drawn by the
# CPU, run as the box user by bb-box-display.service. Installed as
# /usr/local/libexec/bb-box/display in the Wayland desktop template.
#
#   display              start Sway (the service's main process)
#   display wait         wait until Sway answers and has said its Wayland
#                        socket (the service's ExecStartPost)
#   display ready        Sway's config runs this: writes display.env
#   display resize WxH   set the output's size, then move and shrink each
#                        floating window into it, less the bar
#   display vnc-config   write wayvnc's config from the box's VNC password
#                        (bb-box-vnc.service's ExecStartPre)
#
# /run/bb-box/display.env has WAYLAND_DISPLAY, SWAYSOCK and the session's
# XDG_ variables, and no DISPLAY: SSH commands, the units and Cua read it.
# Each command exits 0 when it worked, and otherwise non-zero with the reason
# on stderr.
set -u
run=/run/bb-box
output=HEADLESS-1
export SWAYSOCK=$run/sway.sock

wait_sway() {
  for _ in $(seq 1 200); do
    [ -s "$run/display.env" ] && swaymsg -t get_version >/dev/null 2>&1 && return 0
    sleep 0.05
  done
  echo "display: Sway did not answer within 10 s" >&2
  return 1
}

case "${1:-}" in
  "") ;;
  wait)
    wait_sway
    exit
    ;;
  ready)
    # Run by Sway, so its Wayland socket is in the environment. A Docker
    # box's commands have no login to give them XDG_RUNTIME_DIR, where the
    # socket and wayvnc's control socket are, so it is here too.
    {
      echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
      echo "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
      echo "SWAYSOCK=$SWAYSOCK"
      echo "XDG_SESSION_TYPE=wayland"
      echo "XDG_CURRENT_DESKTOP=sway"
    } >"$run/display.env.new"
    mv "$run/display.env.new" "$run/display.env"
    exit
    ;;
  resize)
    size=${2:-}
    [[ "$size" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]] || { echo "usage: display resize <width>x<height>" >&2; exit 2; }
    # swaymsg prints Sway's reply, which says why a command failed.
    sway_do() { # what command
      local reply
      reply=$(swaymsg -r "$2" 2>&1) && return 0
      echo "display: Sway could not $1: $(python3 -c 'import json, sys; print("; ".join(r.get("error", "") for r in json.load(sys.stdin)))' <<<"$reply" 2>/dev/null || echo "$reply")" >&2
      return 1
    }
    sway_do "set $output to $size" "output $output mode $size" || exit 1
    # Floating windows may now be partly outside the output: move and shrink
    # each into its workspace's area, the output less the bar, in one command.
    # A floating window's size in `resize set` includes its title bar.
    fit=$(swaymsg -r -t get_tree | python3 -c '
import json, sys
cmds = []
def walk(node):
    if node.get("type") == "workspace":
        area = node["rect"]
        for n in node.get("floating_nodes", []):
            r, deco = n["rect"], n["deco_rect"]["height"]
            w, h = min(r["width"], area["width"]), min(r["height"] + deco, area["height"])
            x = min(max(r["x"], area["x"]), area["x"] + area["width"] - w)
            y = min(max(r["y"] - deco, area["y"]), area["y"] + area["height"] - h)
            if (w, h, x, y) != (r["width"], r["height"] + deco, r["x"], r["y"] - deco):
                cmds.append("[con_id=%d] resize set %d %d, move absolute position %d %d" % (n["id"], w, h, x, y))
    for child in node.get("nodes", []):
        walk(child)
walk(json.load(sys.stdin))
print("; ".join(cmds))
') || exit 1
    [ -z "$fit" ] || sway_do "fit the windows into $size" "$fit" || exit 1
    # Return once wayvnc serves the new size, which a new connection's
    # ServerInit gives (021). With no viewer connected wayvnc 0.7.2 is not
    # capturing, so a new viewer's ServerInit still has the old size, and a
    # viewer that connects after such a resize can crash it (#394). Then it
    # exits, and its unit starts it again at once, at the new size. With a
    # viewer connected it follows the change itself: it answers its control
    # socket once it has, a few milliseconds. But if the last viewer leaves
    # within about 50 ms of that, as the relay's own connection can just
    # before a resize, the next viewer crashes it too (#394, #411). So such a
    # resize waits 150 ms more, and then starts wayvnc again if none is left.
    if pgrep -u "$(id -u)" -x wayvnc >/dev/null; then
      viewers() { wayvncctl --json client-list 2>/dev/null | python3 -c 'import json, sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo 0; }
      restart() {
        local old new
        old=$(pgrep -u "$(id -u)" -x wayvnc)
        wayvncctl wayvnc-exit >/dev/null 2>&1
        # The new wayvnc is up when its control socket answers.
        for _ in $(seq 1 150); do
          new=$(pgrep -u "$(id -u)" -x wayvnc)
          [ -n "$new" ] && [ "$new" != "$old" ] && wayvncctl version >/dev/null 2>&1 && break
          sleep 0.02
        done
      }
      serves() {
        for _ in $(seq 1 100); do
          wayvncctl --json output-list 2>/dev/null | python3 -c '
import json, sys
o = [x for x in json.load(sys.stdin) if x["name"] == sys.argv[1]]
sys.exit(0 if o and "%dx%d" % (o[0]["width"], o[0]["height"]) == sys.argv[2] else 1)' "$output" "$size" && return
          sleep 0.02
        done
      }
      if [ "$(viewers)" = 0 ]; then
        restart
        serves
      else
        serves
        sleep 0.15
        if [ "$(viewers)" = 0 ]; then
          restart
          serves
        fi
      fi
    fi
    exit 0
    ;;
  vnc-config)
    # wayvnc offers no VNC password (type 2). With a user and password and
    # relax_encryption it offers Apple Diffie-Hellman (type 30), which the
    # relay speaks.
    umask 077
    if [ "${VNC_AUTH:-password}" = none ]; then
      : >"$run/wayvnc.conf"
    else
      password=$(cat /var/lib/bb-box/vnc-password) || exit 1
      printf 'enable_auth=true\nusername=%s\npassword=%s\nrelax_encryption=true\n' "$(id -un)" "$password" >"$run/wayvnc.conf"
    fi
    exit 0
    ;;
  *)
    echo "usage: display [wait | ready | resize <width>x<height> | vnc-config]" >&2
    exit 2
    ;;
esac

# The display: always the CPU here, as the template has no GPU.
rm -f "$run/display.env" "$SWAYSOCK"
echo cpu >"$run/display-mode"
echo "DISPLAY_MODE=cpu" >"$run/display-reason"
printf 'output %s mode %s\n' "$output" "${DISPLAY_GEOMETRY:-1920x1080}" >"$run/sway-output.conf"
unset DISPLAY XAUTHORITY
export WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway
echo "display: Sway on the CPU" >&2
# The host's NVIDIA module shows in /proc/modules inside a CT, and Sway then
# refuses to start without --unsupported-gpu. It uses no GPU here: it draws
# with pixman on the CPU.
exec sway --unsupported-gpu -c /etc/bb-box/sway.conf
