# EXAMPLE settings for bb-box's Proxmox LXC host scripts. Copy it to
# /etc/bb-box/bb-box.env on the Proxmox host and change what differs on yours.
# Every script in host/ and template/ reads this file; the values below are
# the defaults each script uses when a setting is missing.

# Proxmox
BBBOX_NODE=                      # default: this host's node name (hostname)
BBBOX_POOL=bbbox                 # resource pool holding templates and boxes
BBBOX_STORAGE=local-lvm          # needs linked clones: LVM-thin, ZFS or Ceph RBD
BBBOX_OS_TEMPLATE=local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst
BBBOX_BUILD_VMID=                # build.sh --replace builds here; default: the next free VMID
BBBOX_GPU_REPORT_VMID=           # setup-gpu-report.sh's VM: required, outside bb-box's VMID range

# Box network: a bridge with no physical port, routed and masqueraded by the host.
BBBOX_BRIDGE=vmbr200
BBBOX_GATEWAY_CIDR=10.200.0.1/24 # the host's address on the bridge, and the subnet
BBBOX_BUILD_ADDRESS=10.200.0.2   # used by template builds only
BBBOX_DNS="1.1.1.1 9.9.9.9"      # resolvers baked into the templates

# Optional DNAT rules for boxes, space separated, each ADDRESS:PORT=TARGET.
# Use this when a name boxes need (such as your BB server's) resolves to an
# address that only answers traffic from elsewhere, for example the host's own
# VPN address with a port forward that only matches VPN traffic.
BBBOX_DNAT=

# BB server. When set, template builds pre-install its bb-app package for the
# box user, so enrolling a box as a BB machine skips that download.
BBBOX_BB_URL=                    # for example https://bb.example.com
BBBOX_BB_RESOLVE=                # optional curl --resolve for the host, HOST:443:ADDRESS

# The plugin's SSH key pair; created if missing. Its public key goes into the
# templates for the box user and root.
BBBOX_SSH_KEY=/root/bb-box/ssh/id_ed25519

# The plugin's Proxmox identity (setup-token.sh).
BBBOX_API_USER=bbbox@pve
BBBOX_API_TOKEN=plugin
BBBOX_API_ROLE=BBBoxPlugin
BBBOX_TOKEN_FILE=/root/bb-box/proxmox-token.env
