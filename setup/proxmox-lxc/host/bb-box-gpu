my $UUID = qr/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/;
my $MARKER = qr/^gpu\.(?:(none|release)|(shared|whole)\.($UUID))\.g([1-9][0-9]{0,8})$/;
my $SMI_FIELDS = 'uuid,pci.bus_id,index,memory.free,memory.total';
my $ROOT = $ENV{BBBOX_GPU_ROOT} // '';
my $stopping = 0;
my $dry_run_fixed = 0;
my $previewing = 0;
my $locks_held = 0;
my @held_notes;
my %noted;

sub host_path { return $ROOT . $_[0] }

sub monotonic { return clock_gettime(CLOCK_MONOTONIC) }

sub note {
    my ($text) = @_;
    if ($locks_held) {
        push @held_notes, $text;
        return;
    }
    print STDERR "$text\n";
}

sub holding {
    my ($code) = @_;
    $locks_held++;
    my @result;
    my $ok = eval { @result = $code->(); 1 };
    my $error = $@;
    $locks_held--;
    if (!$locks_held) {
        my @lines = splice @held_notes;
        print STDERR "$_\n" for @lines;
    }
    die $error unless $ok;
    return wantarray ? @result : $result[0];
}

sub note_once {
    my ($key, $text) = @_;
    return if $noted{$key}++;
    note($text);
}

sub usage {
    print <<"USAGE";
bb-box-gpu @{[VERSION]}, protocol @{[PROTOCOL]}: the host's GPU helper for bb-box.

  bb-box-gpu          run as a service: scan every second, answer markers,
                      write the report in the notes of VM @{[REPORT_VM_NAME]},
                      on its first pass and whenever it has something new
  bb-box-gpu --once   one pass, with one reading of the cards, then exit
  bb-box-gpu --boot   the boot pass: put each claimed guest's device lines
                      right from its claim, before guests start
  bb-box-gpu --preview
                      one pass as writes on would make it, changing nothing:
                      no guest, ledger or report is written and no guest's
                      config is locked; it prints each write writes on would
                      make, and each answer it would give
  --dry-run           with --once or --boot, or as a service: writes stay
                      off, whatever the settings say, as setup-gpu.sh
                      installs it until setup-gpu.sh --writes on

Settings: @{[CONFIG_FILE]} ("pools <pool> ...", "writes on|off"). Writes are off
unless that file, owned by this user and writable by no one else, says on, and
pve-container is a version this release was tested on (@{[join(' ', TESTED_PVE_CONTAINER)]}).
USAGE
}

sub load_proxmox {
