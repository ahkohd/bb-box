#!/bin/sh
# A fake Windows box's PowerShell, as the $SHELL that runs its scripts with
# -c. It cannot run PowerShell. A script with bb-box's watchdog, or a job
# whose runner stops it at its timeout (#414), runs for 1.5 s and exits 1, as
# PowerShell does when the watchdog or the runner ends it; one that runs a
# desktop command through a scheduled task says so; any other exits 1 at once.
case "$2" in
*"taskkill /F /PID"* | *"taskkill /T /F /PID"*) sleep 1.5 ;;
*"New-Object -ComObject Schedule.Service"*) echo "a scheduled task" ;;
esac
exit 1
